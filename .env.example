# =====================================================================
# ResumePilot AI — Production & Environment Configuration
# =====================================================================

# Primary Website Production URL (Leave blank to automatically auto-detect via window.location.origin)
VITE_WEBSITE_URL=https://resumepilot.ai

# Google Maps & Location Autocomplete API Key
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Google Analytics / Measurement ID
VITE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Frontend Configuration
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Razorpay Indian Payment Gateway Keys (Live / Sandbox)
VITE_RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID

# Backend-only secrets: configure in your deployment secret manager, never expose as VITE_* variables.
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_SECRET=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
