# ResumePilot AI production configuration
# Public VITE_* values are compiled into the browser. Never place provider secrets in VITE_*.

VITE_WEBSITE_URL=https://resumepilot.example
VITE_FIREBASE_KEY=public-firebase-web-api-key
VITE_FIREBASE_DOMAIN=project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=project-id
VITE_FIREBASE_STORAGE_BUCKET=project.appspot.com
VITE_FIREBASE_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:public-app-id
VITE_GOOGLE_MAPS_API_KEY=browser-restricted-maps-key
VITE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_RAZORPAY_KEY_ID=rzp_test_public-key-id

# Backend runtime
NODE_ENV=production
PORT=8080
PROTOCOL=https
WEBSITE_NAME=resumepilot.example

# Database Abstraction Layer
# MySQL/MariaDB is the single authoritative database. The Firestore data
# plane is OPT-IN and only ever a standby for asynchronous replication.
DB_ENGINE=mysql

# MySQL / MariaDB connection settings (required)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_resume_builder

# ───────────────────────────────────────────────────────────────────────────
# Firestore DATA PLANE (default OFF — zero Firestore on production paths)
#
# FIREBASE_DATA_PLANE=off        (default) MySQL-only; Firestore is never read,
#                                written, or awaited on any synchronous path.
# FIREBASE_DATA_PLANE=on         OPT-IN operator flag: enables the Firestore
#                                STANDBY for asynchronous outbox replication
#                                only. MySQL remains authoritative.
#
# Identity (Firebase Auth) is always used for ID-token verification and is
# configured below under FIREBASE_* — that is an identity service, not a
# database dependency.
# ───────────────────────────────────────────────────────────────────────────
FIREBASE_DATA_PLANE=off

# Canonical public origin used for email CTAs, OAuth callbacks, and password
# reset links. When set, this overrides PROTOCOL + WEBSITE_NAME. Never point
# this at localhost in production.
# PUBLIC_APP_URL=https://your-production-hostname
# Enterprise tenancy is dark by default. Enable only after the identity,
# migration, and operational proof gates are approved.
ENTERPRISE_TENANCY_ENABLED=false
VITE_ENTERPRISE_TENANCY_ENABLED=false
# ---------------------------------------------------------------------------
# Enterprise architecture (Firebase-native; zero external infrastructure)
# ---------------------------------------------------------------------------
# Firestore is the ONLY enterprise data plane. There is no PostgreSQL, Redis,
# broker, or KMS dependency, and no ENTERPRISE_DATA_PROVIDER / DATABASE_URL /
# REDIS_URL variable is used by the enterprise runtime.
# Server-side encryption keys for enterprise resource payloads (AES-256-GCM
# envelope encryption). Generate with: openssl rand -base64 32
# Required when ENTERPRISE_TENANCY_ENABLED=true — resource writes fail closed
# without a key. Supports versioned rotation, e.g.
#   ENTERPRISE_ENCRYPTION_KEYS={"v1":"<base64>","v2":"<base64>"}
#   ENTERPRISE_ENCRYPTION_ACTIVE_KEY=v2
ENTERPRISE_ENCRYPTION_PROVIDER=server-key
ENTERPRISE_ENCRYPTION_KEY=
# ENTERPRISE_ENCRYPTION_KEYS=
# ENTERPRISE_ENCRYPTION_ACTIVE_KEY=
# Minimum 32-byte server-only signing secret for tenant job envelopes.
TENANT_JOB_SIGNING_SECRET=
# Minimum 32-byte server-only signing secret for tenant artifact tokens.
TENANT_ARTIFACT_SIGNING_SECRET=
# Durable enterprise job worker (Firestore outbox). Enable on worker-capable
# backend instances; the queue itself is durable whether or not a local worker
# runs in this process.
ENTERPRISE_OUTBOX_WORKER_ENABLED=false
ENTERPRISE_OUTBOX_INTERVAL_MS=15000
# Enterprise artifact object storage. firebase-storage is the implemented
# provider; s3/r2 are extension points and fail closed if selected.
ENTERPRISE_STORAGE_PROVIDER=firebase-storage
ENTERPRISE_STORAGE_BUCKET=
CORS_ALLOWED_ORIGINS=https://resumepilot.example
# Leave unset for the checked-in loopback Apache/PHP proxy trust policy. Configure explicitly
# only after validating the production load-balancer hop count.
TRUST_PROXY_HOPS=

# Prefer Workload Identity / Application Default Credentials in production.
FIREBASE_PROJECT_ID=project-id
FIREBASE_DATABASE_URL=https://project-default-rtdb.firebaseio.com
FIREBASE_USE_ADC=true
# Key-based fallback (avoid when Workload Identity is available):
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI provider secrets (backend/secret manager only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
AI_BASIC_DAILY_LIMIT=10
AI_PREMIUM_DAILY_LIMIT=100
AI_BURST_LIMIT=12
AI_BURST_WINDOW_MS=60000

# Payment provider secrets
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=WEBSTAGING
PAYTM_ENV=staging
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=sandbox

# OAuth secrets
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP/IMAP and notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=ResumePilot AI
SMTP_REPLY_TO=support@resumepilot.example
ADMIN_EMAIL=security@resumepilot.example
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Abuse controls
NOTIFICATION_HOURLY_LIMIT=8
CONTACT_HOURLY_LIMIT=3
EXPORT_HOURLY_LIMIT=20
SCRAPER_HOURLY_LIMIT=2
MESSAGING_FIVE_MINUTE_LIMIT=30
SENSITIVE_AUTH_MAX_AGE_MS=600000

# Trusted CMS scheduled-publication worker (backend only)
CMS_SCHEDULER_ENABLED=false
CMS_SCHEDULER_INTERVAL_MS=300000

# Durable notification outbox worker (uses Firestore leases; enable on worker-capable backend instances)
NOTIFICATION_OUTBOX_WORKER_ENABLED=false
NOTIFICATION_OUTBOX_EXTERNAL_WORKER=false
NOTIFICATION_OUTBOX_INTERVAL_MS=15000

# Tenant hard-deletion garbage collector (backend only). Reclaims tenants in
# DELETING state after the grace period: deletes the tenant data partition,
# control-plane records, configuration, and identity-map entries. Without this
# worker, hard deletion only happens when scripts/tenant-garbage-collector.mjs
# is run manually (or a Super Admin triggers /api/platform/tenants/garbage-collect).
TENANT_GC_WORKER_ENABLED=false
TENANT_GC_INTERVAL_MS=3600000
TENANT_GC_GRACE_PERIOD_DAYS=7

# Set only when PDF execution is deployed in a dedicated non-root sandboxed worker/container
PDF_RENDERER_ISOLATED=false
