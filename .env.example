# ResumePilot AI production configuration
# Public VITE_* values are compiled into the browser. Never place provider secrets in VITE_*.

VITE_WEBSITE_URL=https://resumepilot.example
# Firebase Web identifiers used only by Firebase Authentication.
VITE_FIREBASE_KEY=public-firebase-web-api-key
VITE_FIREBASE_DOMAIN=project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=project-id
VITE_FIREBASE_APP_ID=1:000000000000:web:public-app-id
VITE_GOOGLE_MAPS_API_KEY=browser-restricted-maps-key
VITE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_RAZORPAY_KEY_ID=rzp_test_public-key-id

# Backend runtime
NODE_ENV=production
PORT=8080
PROTOCOL=https
WEBSITE_NAME=resumepilot.example

# ───────────────────────────────────────────────────────────────────────────
# AUTHORITATIVE DATABASE: MySQL/MariaDB (single source of truth)
#
# The Firestore DATA PLANE HAS BEEN REMOVED from the runtime. There is no
# FIREBASE_DATA_PLANE switch and no engine switch: MySQL/MariaDB is the sole
# store for all persistent business data. Firestore is not a fallback, not a
# standby, and is not consulted on any synchronous or asynchronous production
# path. Historical data migration, if required, must use separately reviewed,
# one-time tooling outside the application runtime.
#
# Identity (Firebase Auth) remains the identity provider for ID-token
# verification — configured below under FIREBASE_*. That is an identity
# service, not a database dependency.
# ───────────────────────────────────────────────────────────────────────────

# MariaDB connection settings (all required). Use a least-privilege application
# account provisioned by the secret manager; never run the service as DB root.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=ai_resume_builder
# Optional pool tuning:
# DB_CONNECTION_LIMIT=15
# DB_CONNECT_TIMEOUT_MS=8000
# DB_SSL=true

# Backup/restore CLI (`scripts/db-backup.mjs`). Use a separate least-privilege
# backup identity in production and inject this 32-byte key from a secret/KMS.
# Generate key material with: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY_BASE64=
# Destructive restore is additionally gated at invocation time with the exact
# value DB_RESTORE_CONFIRM=RESTORE:<DB_NAME>; do not persist that confirmation.

# Canonical public origin used for email CTAs, OAuth callbacks, and password
# reset links. When set, this overrides PROTOCOL + WEBSITE_NAME. Never point
# this at localhost in production.
# PUBLIC_APP_URL=https://your-production-hostname
# Enterprise tenancy is dark by default. Enable only after the identity,
# migration, and operational proof gates are approved.
ENTERPRISE_TENANCY_ENABLED=false
VITE_ENTERPRISE_TENANCY_ENABLED=false
# ---------------------------------------------------------------------------
# Enterprise architecture (MariaDB authoritative)
# ---------------------------------------------------------------------------
# Enterprise registry, resources, memberships, audit, and durable jobs use the
# same MariaDB authority configured above. The provider is immutable at runtime.
ENTERPRISE_DATA_PROVIDER=mysql
# Server-side encryption keys for enterprise resource payloads (AES-256-GCM
# envelope encryption). Generate with: openssl rand -base64 32
# Required when ENTERPRISE_TENANCY_ENABLED=true — protected writes fail closed
# without a key. Prefer a versioned key ring so existing envelopes remain
# decryptable during rotation, for example:
#   ENTERPRISE_ENCRYPTION_KEYS={"v1":"<base64>","v2":"<base64>"}
#   ENTERPRISE_ENCRYPTION_ACTIVE_KEY=v2
ENTERPRISE_ENCRYPTION_PROVIDER=server-key
ENTERPRISE_ENCRYPTION_KEY=
# ENTERPRISE_ENCRYPTION_KEY_VERSION=v1
# ENTERPRISE_ENCRYPTION_KEYS=
# ENTERPRISE_ENCRYPTION_ACTIVE_KEY=
# Minimum 32-byte server-only signing secrets for tenant job and artifact tokens.
TENANT_JOB_SIGNING_SECRET=
TENANT_ARTIFACT_SIGNING_SECRET=
# Durable MariaDB enterprise outbox worker. Enable on designated worker-capable
# instances; queued jobs remain durable while workers are unavailable.
ENTERPRISE_OUTBOX_WORKER_ENABLED=false
ENTERPRISE_OUTBOX_INTERVAL_MS=15000
CORS_ALLOWED_ORIGINS=https://resumepilot.example
# Leave unset for the checked-in loopback Apache/PHP proxy trust policy. Configure explicitly
# only after validating the production load-balancer hop count.
TRUST_PROXY_HOPS=

# Firebase Admin is used only for identity operations. Prefer Workload Identity
# / Application Default Credentials in production; no Firebase database URL is
# required or accepted by the Auth-only adapter.
FIREBASE_PROJECT_ID=project-id
FIREBASE_USE_ADC=true
# Key-based fallback (avoid when Workload Identity is available):
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI provider secrets (backend/secret manager only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
# Optional self-hosted / private AI gateway overrides (OpenAI-compatible).
# Useful for on-prem deployments and acceptance testing. Leave unset to use
# each provider's public endpoint.
# OPENAI_BASE_URL=https://ai-gateway.example/v1
# GROQ_BASE_URL=
# NVIDIA_BASE_URL=
# OPENROUTER_BASE_URL=
# DEEPSEEK_BASE_URL=
# GEMINI_BASE_URL=
AI_BASIC_DAILY_LIMIT=10
AI_PREMIUM_DAILY_LIMIT=100
AI_BURST_LIMIT=12
AI_BURST_WINDOW_MS=60000

# Payment provider secrets
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=WEBSTAGING
PAYTM_ENV=staging
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=sandbox

# OAuth secrets
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP/IMAP and notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=ResumePilot AI
SMTP_REPLY_TO=support@resumepilot.example
ADMIN_EMAIL=security@resumepilot.example
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Abuse controls
NOTIFICATION_HOURLY_LIMIT=8
CONTACT_HOURLY_LIMIT=3
EXPORT_HOURLY_LIMIT=20
SCRAPER_HOURLY_LIMIT=2
MESSAGING_FIVE_MINUTE_LIMIT=30
SENSITIVE_AUTH_MAX_AGE_MS=600000

# Trusted CMS scheduled-publication worker (backend only)
CMS_SCHEDULER_ENABLED=false
CMS_SCHEDULER_INTERVAL_MS=300000

# Durable notification outbox worker (MySQL transactional outbox with lease-based
# claims, exponential backoff + jitter, and dead-letter; enable on worker-capable
# backend instances). The queue lives in the MySQL notification_outbox table.
NOTIFICATION_OUTBOX_WORKER_ENABLED=false
NOTIFICATION_OUTBOX_EXTERNAL_WORKER=false
NOTIFICATION_OUTBOX_INTERVAL_MS=15000

# Tenant hard-deletion garbage collector (backend only). Reclaims tenants in
# DELETING state after the grace period: deletes the tenant data partition,
# control-plane records, configuration, and identity-map entries. An authorized
# Super Admin can also trigger the audited garbage-collection API.
TENANT_GC_WORKER_ENABLED=false
TENANT_GC_INTERVAL_MS=3600000
TENANT_GC_GRACE_PERIOD_DAYS=7

# Set only when PDF execution is deployed in a dedicated non-root sandboxed worker/container
PDF_RENDERER_ISOLATED=false
