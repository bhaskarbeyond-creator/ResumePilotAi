# Environment variables
.env
.env*
!.env.example
# Any env file regardless of prefix. `.env*` only matches names that START with
# ".env", so files like remote.env / prod.env / backend.env slipped through and
# were committed with live credentials. These patterns close that gap.
*.env
!example.env
**/*.env
!**/example.env
!**/*.example.env
# Service-account and key material
*service-account*.json
*serviceaccount*.json
*credentials*.json
*.p12
*.pfx
*.key
# OpenSSH identities often have no extension; keep operator material out of Git.
**/id_ed25519*
**/id_rsa*
**/id_ecdsa*
**/dev_key*
**/known_hosts*
/.release/

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Forensic lab artifacts (evidence, regenerable)
template-lab/shots/
template-lab/sheets/
template-lab/audit-results.json
template-lab/visual-metrics.json

# A4 PDF evidence artifacts (regenerable)
template-lab/evidence/
template-lab/pdf-evidence.json

# Regenerable DOCX forensic binaries and generated matrices
artifacts/
scratch/
test-results/

# Certification evidence / scratch workspace (regenerable)
.arena/

# ── Database recovery artifacts ────────────────────────────────────────────
# Backup output must never enter Git. A committed dump is a credential and PII
# disclosure, and it is also not a backup: it lives in the same place as the
# code it is supposed to protect. Rules are scoped to backup directories so
# tracked schema migrations under backend/database/migrations/*.sql stay tracked.
/backups/scheduled/
/backups/restore-points/
/backups/runs/
/backups/**/*.sql
/backups/**/*.sql.gz
/backups/**/*.sql.gz.enc
/backups/**/*.enc
/backups/**/*.sha256
/backups/**/recovery-points.json
/backups/**/restore-point-*.json
tests/.auth-states/
node_modules/
.env.local
backend/.env
tests/.auth-states/
test-results/
playwright-report/
scripts/capture-user-dashboard-visuals.mjs
scripts/capture-user-dashboard-visuals.mjs
