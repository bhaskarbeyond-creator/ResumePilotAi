# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules
__pycache__/
*.py[cod]
/.pnp
.pnp.js

# Testing
/coverage

# Build outputs
dist
dist-ssr
/build
*.local
backend/COMMIT_SHA

# Next.js
/.next/
/out/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
*.pem

# Environment variables
.env
.env*
!.env.example
# Any env file regardless of prefix. `.env*` only matches names that START with
# ".env", so files like remote.env / prod.env / backend.env slipped through and
# were committed with live credentials. These patterns close that gap.
*.env
!example.env
**/*.env
!**/example.env
# Service-account and key material
*service-account*.json
*serviceaccount*.json
*credentials*.json
*.p12
*.pfx
*.key
# OpenSSH identities often have no extension; keep operator material out of Git.
**/id_ed25519*
**/id_rsa*
**/id_ecdsa*
**/dev_key*
**/known_hosts*
/.release/

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Forensic lab artifacts (evidence, regenerable)
template-lab/shots/
template-lab/sheets/
template-lab/audit-results.json
template-lab/visual-metrics.json

# A4 PDF evidence artifacts (regenerable)
template-lab/evidence/
template-lab/pdf-evidence.json

# Regenerable DOCX forensic binaries and generated matrices
artifacts/
scratch/
test-results/

# Certification evidence / scratch workspace (regenerable)
.arena/
