{
  "endpoint": "GET /api/admin/users/:uid/details",
  "architecture": "MySQL-First with Non-Blocking Identity & Fallbacks",
  "fields": {
    "identity": {
      "authoritativePrimary": "MariaDB users table (email, displayName, role, suspended, emailVerified)",
      "directoryEnrichment": "Firebase Auth (getUser - non-blocking)",
      "failureStrategy": "Fail open to MariaDB profile data if Firebase Auth is slow/unavailable"
    },
    "profile": {
      "authoritativePrimary": "MariaDB users table",
      "fields": ["firstname", "lastname", "phone", "location", "jobTitle", "bio", "website", "socialLinks", "photoURL", "preferredCurrency"]
    },
    "membership": {
      "authoritativePrimary": "MariaDB users table",
      "fields": ["membership", "membershipEnds", "paymentStatus", "aiQuotaOverride"]
    },
    "content": {
      "authoritativePrimary": "MariaDB aggregate query (resumes, portfolios, covers tables)",
      "fields": ["resumeCount", "portfolioCount", "coverCount", "recentResumes"]
    },
    "billing": {
      "authoritativePrimary": "MariaDB payment_orders & subscriptions tables",
      "fields": ["orders", "totalSpent", "activeSubscription"]
    },
    "security": {
      "mfaStatus": "Firebase Auth enrolled factors (non-blocking fallback to false)",
      "sessionState": "Tokens valid after timestamp"
    },
    "auditTimeline": {
      "authoritativePrimary": "MariaDB admin_audit_logs & security_audit_logs tables",
      "secondaryFallback": "Firestore standby (non-blocking)",
      "fields": ["id", "action", "actorUid", "category", "severity", "changes", "createdAt"]
    }
  },
  "http503EliminationGuarantee": "0% chance of HTTP 503 when MariaDB is healthy."
}
