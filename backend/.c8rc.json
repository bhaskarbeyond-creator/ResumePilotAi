{
  "include": [
    "config/registry.js",
    "services/configService.js",
    "services/operationalMetrics.js",
    "services/rootAccountReconciliation.js",
    "services/adminRbac.js",
    "services/adminRbacAdministration.js",
    "security/capabilityMap.js",
    "security/routeManifest.js",
    "security/policy.js",
    "security/permissionVocabulary.js",
    "routes/config.js",
    "routes/capabilities.js",
    "routes/adminRbac.js"
  ],
  "exclude": [
    "**/node_modules/**",
    "test/**",
    "test-support/**"
  ],
  "clean": true,
  "check-coverage": true,
  "per-file": false,
  "lines": 95,
  "statements": 95,
  "functions": 90,
  "branches": 85,
  "reporter": [
    "text-summary",
    "json-summary",
    "lcov"
  ]
}
