            <div>
              <div className="font-bold text-ink">Generative Documents</div>
              <div className="text-[11px] text-ink-muted">Cover Letters, Executive Summaries, CV Bios</div>
              <div className="text-[10px] font-mono text-purple-600 dark:text-purple-400 font-semibold mt-0.5">
                â†³ Gemini 2.0 / Llama 3.3 70B (Temp 0.45)
              </div>
            </div>
          </div>

          <div className="flex items-start gap-2.5 p-2.5 rounded-xl bg-surface/60 border border-border/40">
            <Shield className="size-4 text-blue-500 mt-0.5 shrink-0" />
            <div>
              <div className="font-bold text-ink">Context & Reasoning</div>
              <div className="text-[11px] text-ink-muted">AI Interview Coach, CBT Simulator</div>
              <div className="text-[10px] font-mono text-blue-600 dark:text-blue-400 font-semibold mt-0.5">
                â†³ DeepSeek / NVIDIA NIM 70B (Temp 0.35)
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* â”€â”€â”€ LIVE TEST EXECUTION TOAST / BANNER â”€â”€â”€ */}
      {lastTestNotice && (
        <div
          data-testid="live-test-feedback-banner"
          className={cn(
            'p-3 rounded-xl border flex items-center justify-between text-xs transition-all shadow-xs animate-in fade-in slide-in-from-top-1',
            lastTestNotice.ok
              ? 'bg-emerald-50/95 dark:bg-emerald-950/50 border-emerald-300 dark:border-emerald-800 text-emerald-900 dark:text-emerald-100'
              : 'bg-rose-50/95 dark:bg-rose-950/50 border-rose-300 dark:border-rose-800 text-rose-900 dark:text-rose-100'
          )}
        >
          <div className="flex items-center gap-2.5 min-w-0">
            {lastTestNotice.ok ? (
              <CheckCircle2 className="size-4 text-emerald-600 dark:text-emerald-400 shrink-0" />
            ) : (
              <AlertCircle className="size-4 text-rose-600 dark:text-rose-400 shrink-0" />
            )}
            <div className="truncate">
              <span className="font-bold">{lastTestNotice.name}: </span>
              <span>{lastTestNotice.message}</span>
              {lastTestNotice.latencyMs && (
                <span className="ml-2 font-mono font-bold px-1.5 py-0.5 rounded bg-emerald-200/60 dark:bg-emerald-900/60 text-emerald-900 dark:text-emerald-200 text-[10px]">
                  âš¡ {lastTestNotice.latencyMs}ms
                </span>
              )}
            </div>
          </div>
          <button
            type="button"
            aria-label="Dismiss test notice"
            onClick={() => setLastTestNotice(null)}
            className="p-1 rounded-md text-ink-muted hover:text-ink hover:bg-black/5 dark:hover:bg-white/5 shrink-0"
          >
            <X className="size-3.5" />
          </button>
        </div>
      )}

      {/* â”€â”€â”€ INLINE OPERATION TOAST / BANNER (Cuba M3) â”€â”€â”€ */}
      {inlineNotice && (
        <div
          data-testid="inline-operation-notice"
          className={cn(
            'p-3 rounded-xl border flex items-center justify-between text-xs transition-all shadow-xs animate-in fade-in slide-in-from-top-1',
            inlineNotice.type === 'success'
              ? 'bg-emerald-50/95 dark:bg-emerald-950/50 border-emerald-300 dark:border-emerald-800 text-emerald-900 dark:text-emerald-100'
              : inlineNotice.type === 'error'
              ? 'bg-rose-50/95 dark:bg-rose-950/50 border-rose-300 dark:border-rose-800 text-rose-900 dark:text-rose-100'
              : 'bg-blue-50/95 dark:bg-blue-950/50 border-blue-300 dark:border-blue-800 text-blue-900 dark:text-blue-100'
          )}
        >
          <div className="flex items-center gap-2.5 min-w-0">
            {inlineNotice.type === 'success' ? (
              <CheckCircle2 className="size-4 text-emerald-600 dark:text-emerald-400 shrink-0" />
            ) : inlineNotice.type === 'error' ? (
              <AlertCircle className="size-4 text-rose-600 dark:text-rose-400 shrink-0" />
            ) : (
              <Info className="size-4 text-blue-600 dark:text-blue-400 shrink-0" />
            )}
            <div className="truncate">
              <span>{inlineNotice.text}</span>
            </div>
          </div>
          <button
            type="button"
            aria-label="Dismiss notice"
            onClick={() => setInlineNotice(null)}
            className="p-1 rounded-md text-ink-muted hover:text-ink hover:bg-black/5 dark:hover:bg-white/5 shrink-0"
          >
            <X className="size-3.5" />
          </button>
        </div>
      )}

      {/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */}
      {/* â”€â”€â”€ MASTER TOP TAB BAR â”€â”€â”€ */}
      {/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-border/60 pb-3">
        <div className="flex items-center gap-2 overflow-x-auto p-1 rounded-xl bg-surface-secondary/70">
          <button
            type="button"
            onClick={() => handleSelectTab('keys')}
            className={cn(
              'px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 whitespace-nowrap shrink-0',
              activeTab === 'keys'
                ? 'bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 shadow-sm'
                : 'text-ink-muted hover:text-ink hover:bg-surface-secondary'
            )}
          >
            <Key className="size-3.5" />
            Keys ({providers.length})
          </button>

          <button
            type="button"
            onClick={() => handleSelectTab('models')}
            className={cn(
              'px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 whitespace-nowrap shrink-0',
              activeTab === 'models'
                ? 'bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 shadow-sm'
                : 'text-ink-muted hover:text-ink hover:bg-surface-secondary'
            )}
          >
            <Layers className="size-3.5" />
            Models & Fallback Chains
          </button>

          <button
            type="button"
            onClick={() => handleSelectTab('claude')}
            className={cn(
              'px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 whitespace-nowrap shrink-0',
              activeTab === 'claude'
                ? 'bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 shadow-sm'
                : 'text-ink-muted hover:text-ink hover:bg-surface-secondary'
            )}
          >
            <Terminal className="size-3.5" />
            Claude Code & Agents
          </button>

          <button
            type="button"
            onClick={() => handleSelectTab('playground')}
            className={cn(
              'px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 whitespace-nowrap shrink-0',
              activeTab === 'playground'
                ? 'bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 shadow-sm'
                : 'text-ink-muted hover:text-ink hover:bg-surface-secondary'
            )}
          >
            <Sparkles className="size-3.5" />
            Playground
          </button>
        </div>

        <div className="flex items-center gap-2">
          {savedSuccess && (
            <span className="inline-flex items-center gap-1 rounded-md border border-emerald-300 bg-emerald-50 dark:bg-emerald-950/40 px-2.5 py-1 text-xs font-bold text-emerald-800 dark:text-emerald-300">
              <Check className="size-3 text-emerald-600" />
              Settings Saved
            </span>
          )}
          <Button variant="primary" size="sm" onClick={handleSaveAll} loading={saving} className="h-8 text-xs font-bold">
            Save All Changes
          </Button>
        </div>
      </div>

      {/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */}
      {/* â”€â”€â”€ TAB 1: KEYS (Matching FreeLLMAPI Screen 1) â”€â”€â”€ */}
      {/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */}
      {activeTab === 'keys' && (
        <div className="space-y-6">
          {/* Header Row */}
          <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h1 className="text-2xl font-black text-ink tracking-tight">Keys</h1>
              <p className="text-xs text-ink-muted mt-0.5">
                Provider credentials and the unified API key your apps connect with.
              </p>
            </div>

            <div className="flex flex-wrap items-center gap-2">
              <Button
                variant="outline"
                size="sm"
                onClick={handleCheckAll}
                loading={checkingAll}
                className="h-8 text-xs font-semibold"
              >
                <RefreshCw className={cn('size-3.5 mr-1.5', checkingAll && 'animate-spin')} />
                Check all
              </Button>

              <Button
                variant="outline"
                size="sm"
                onClick={handleExportConfig}
                className="h-8 text-xs font-semibold"
              >
                <Download className="size-3.5 mr-1.5" />
                Export
              </Button>

              <Button
                variant="primary"
                size="sm"
                data-testid="configure-provider"
                onClick={() => {
                  setModalSelectedPlatform(null);
                  setModalPlatformSearch('');
                  setIsAddKeyOpen(true);
                  setIsComboboxOpen(false);
                  setModalError(null);
                }}
                className="h-8 text-xs font-bold bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 hover:bg-neutral-800"
              >
                <Plus className="size-3.5 mr-1" />
                Configure Provider
              </Button>
            </div>
          </div>

          {/* 5 Subtabs Bar for Keys */}
          <div className="flex items-center gap-1.5 overflow-x-auto pb-1 border-b border-border/40 text-xs">
            {(
              [
                { id: 'providers', label: `Providers (${configuredCount}/${providers.length})` },
                { id: 'key-pool', label: 'Key Pool' },
                { id: 'metrics', label: 'Metrics & Cooldowns' },
                { id: 'unified-gateway', label: 'Unified Gateway' },
                { id: 'discovery', label: 'Model Discovery' },
              ] as const
            ).map((tab) => (
              <button
                key={tab.id}
                type="button"
                onClick={() => handleSelectSubTab(tab.id)}
                className={cn(
                  'px-3 py-1.5 rounded-lg font-semibold transition-all whitespace-nowrap',
                  activeSubTab === tab.id
                    ? 'bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 shadow-xs'
                    : 'text-ink-muted hover:text-ink'
                )}
              >
                {tab.label}
              </button>
            ))}
          </div>

          {/* â”€â”€â”€ SUBTAB 1: PROVIDERS CATALOG â”€â”€â”€ */}
          {activeSubTab === 'providers' && (
            <>
              {/* â”€â”€â”€ CORE ENTERPRISE TITANS HIGHLIGHT STRIP â”€â”€â”€ */}
              <div className="space-y-3 pb-3">
                <div className="flex items-center justify-between">
                  <div>
                    <h3 className="text-sm font-bold text-ink flex items-center gap-2">
                      <Shield className="size-4 text-brand-600" />
                      Core Enterprise Titans
                    </h3>
                    <p className="text-xs text-ink-muted">
                      Primary verified engines powering candidate resume generation, ATS matching, and interview simulation.
                    </p>
                  </div>
                  <span className="text-[11px] font-mono font-semibold px-2 py-0.5 rounded-md bg-surface-secondary text-ink-muted border border-border/50">
                    8 Core Titans Â· 66 Community Mesh
                  </span>
                </div>

                <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
                  {[
                    { id: 'nvidia', name: 'NVIDIA NIM', badge: 'Certified Baseline', speed: '800ms', desc: 'Hardware-accelerated Nemotron & Llama 3.2 11B' },
                    { id: 'gemini', name: 'Google Gemini', badge: 'Frontier 1M Ctx', speed: '600ms', desc: 'DeepMind Gemini 2.0 Flash multimodal' },
                    { id: 'groq', name: 'Groq LPU', badge: 'Ultra-Fast 140ms', speed: '140ms', desc: 'Real-time interactive LPU inference' },
                    { id: 'openai', name: 'OpenAI', badge: 'Enterprise Bench', speed: '750ms', desc: 'GPT-4o & GPT-4o-mini structured reasoning' },
                    { id: 'openrouter', name: 'OpenRouter', badge: 'Universal Mesh', speed: '900ms', desc: 'Aggregated frontier models & free mesh' },
                    { id: 'deepseek', name: 'DeepSeek', badge: 'Deep Reasoning', speed: '1100ms', desc: 'DeepSeek V3 / R1 reasoning engine' },
                    { id: 'ovh', name: 'OVHcloud AI', badge: 'Keyless Safety Net', speed: '700ms', desc: 'Keyless European Llama 3.3 70B cloud' },
                    { id: 'pollinations', name: 'Pollinations', badge: 'Zero-Key Mesh', speed: '950ms', desc: 'Zero-config instant failover pool' },
                  ].map((titan) => {
                    const p = providers.find((item) => item.id === titan.id);
                    const isConfigured = Boolean(p?.configuredOnServer || p?.keyless);
                    const isPrimary = primaryProvider === titan.id;

                    return (
                      <div
                        key={titan.id}
                        className={cn(
                          'p-3.5 rounded-xl border transition-all flex flex-col justify-between gap-3',
                          isPrimary
                            ? 'border-brand-500/60 bg-brand-500/5 shadow-xs ring-1 ring-brand-500/30'
                            : isConfigured
                            ? 'border-border/70 bg-surface/90 hover:bg-surface'
                            : 'border-border/40 bg-surface-secondary/40 opacity-80 hover:opacity-100'
                        )}
                      >
                        <div className="space-y-1">
                          <div className="flex items-center justify-between gap-2">
                            <span className="font-bold text-xs text-ink">{titan.name}</span>
                            <span className="text-[10px] font-mono font-bold px-1.5 py-0.5 rounded bg-surface-secondary text-ink-muted border border-border/40">
                              {titan.speed}
                            </span>
                          </div>
                          <div className="text-[10px] text-ink-muted line-clamp-1">{titan.desc}</div>
                          <div className="pt-1 flex items-center gap-1.5 flex-wrap">
                            {isConfigured ? (
                              <span className="inline-flex items-center gap-1 text-[10px] font-semibold text-emerald-600 dark:text-emerald-400">
                                <span className="size-1.5 rounded-full bg-emerald-500" />
                                {p?.keyless ? 'Keyless Active' : 'Configured'}
                              </span>
                            ) : (
                              <span className="text-[10px] text-ink-muted">Not Configured</span>
                            )}
                            {isPrimary && (
                              <span className="text-[9px] font-bold uppercase tracking-wider px-1 py-0.5 rounded bg-brand-500 text-white">
                                Primary
                              </span>
                            )}
                          </div>

                          {/* Live test result on Titan card */}
                          {testStatus[titan.id] && (
                            <div
                              className={cn(
                                'mt-1 px-2 py-0.5 rounded-md text-[10px] font-mono flex items-center justify-between border transition-all animate-in fade-in',
                                testStatus[titan.id].ok
                                  ? 'bg-emerald-50 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-200 border-emerald-200 dark:border-emerald-800'
                                  : 'bg-rose-50 text-rose-800 dark:bg-rose-950/60 dark:text-rose-200 border-rose-200 dark:border-rose-800'
                              )}
                            >
                              <span className="flex items-center gap-1 font-bold">
                                {testStatus[titan.id].ok ? (
                                  <CheckCircle2 className="size-3 text-emerald-600 dark:text-emerald-400 shrink-0" />
                                ) : (
                                  <AlertCircle className="size-3 text-rose-600 dark:text-rose-400 shrink-0" />
                                )}
                                {testStatus[titan.id].ok ? `âš¡ ${testStatus[titan.id].latencyMs || 150}ms` : 'Error'}
                              </span>
                              <span className="truncate max-w-[95px] text-[9px] font-normal" title={testStatus[titan.id].message}>
                                {testStatus[titan.id].ok ? 'Verified' : testStatus[titan.id].message}
                              </span>
                            </div>
                          )}
                        </div>

                        <div className="flex items-center gap-1.5 pt-1 border-t border-border/40">
                          <Button
                            variant="outline"
                            size="xs"
                            onClick={() => handleTestProvider(titan.id, undefined, p?.defaultModel)}
                            loading={testingId === titan.id}
                            data-testid={`titan-test-${titan.id}`}
                            className="h-6 text-[10px] px-2 flex-1"
                          >
                            âš¡ Test
                          </Button>
                          <Button
                            variant="secondary"
                            size="xs"
                            onClick={() => {
                              if (p) {
                                setModalSelectedPlatform(p);
                                setIsAddKeyOpen(true);
                              }
                            }}
                            className="h-6 text-[10px] px-2"
                          >
                            Key
                          </Button>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>

              {/* Provider Category Tabs (Frontier / Community Mesh / Agent Search) */}
              <div
            className="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs"
            role="tablist"
            aria-label="Provider categories"
            data-testid="provider-category-tabs"
          >
            {[
              { id: 'all' as const, label: 'All providers', count: tierCounts.all },
              { id: 'frontier' as const, label: 'Frontier Free Tier', count: tierCounts.frontier },
              { id: 'mesh' as const, label: 'Fast Community Mesh', count: tierCounts.mesh },
              { id: 'search' as const, label: 'Agent Search & Extraction Tools', count: tierCounts.search },
            ].map((tier) => (
              <button
                key={tier.id}
                type="button"
                role="tab"
                aria-selected={tierFilter === tier.id}
                aria-pressed={tierFilter === tier.id}
                data-testid={`provider-tier-${tier.id}`}
                onClick={() => setTierFilter(tier.id)}
                className={cn(
                  'px-3 py-1.5 rounded-lg font-semibold transition-all whitespace-nowrap border',
                  tierFilter === tier.id
                    ? 'bg-neutral-900 text-white border-neutral-900 dark:bg-white dark:text-neutral-900 dark:border-white shadow-xs'
                    : 'bg-surface text-ink-muted border-border/60 hover:text-ink hover:border-border'
                )}
              >
                {tier.label}
                <span
                  className={cn(
                    'ml-1.5 text-[10px] font-bold px-1.5 py-0.5 rounded-md',
                    tierFilter === tier.id
                      ? 'bg-white/20 text-white dark:bg-neutral-900/10 dark:text-neutral-900'
                      : 'bg-surface-secondary text-ink-muted'
                  )}
                >
                  {tier.count}
                </span>
              </button>
            ))}
          </div>

          {/* Search & Status Filters Bar */}
          <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            {/* Search Input â€” isolated in semantic form with search type and anti-autofill guardrails */}
            <form
              role="search"
              onSubmit={(e) => e.preventDefault()}
              autoComplete="off"
              className="relative w-full sm:w-80"
            >
              <Search className="size-3.5 text-ink-muted absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" />
              <Input
                type="search"
                id="ai-provider-search-input"
                name="ai_provider_search_query"
                autoComplete="off"
                autoCorrect="off"
                spellCheck={false}
                data-lpignore="true"
                data-1p-ignore="true"
                data-bwignore="true"
                data-form-type="other"
                value={searchQuery}
                onChange={(e) => setSearchQuery(e.target.value)}
                placeholder="Search platforms, models, keys..."
                className="pl-8 pr-8 h-8 text-xs"
              />
              {searchQuery ? (
                <button
                  type="button"
                  aria-label="Clear search"
                  onClick={() => setSearchQuery('')}
                  className="absolute right-2.5 top-1/2 -translate-y-1/2 text-ink-muted hover:text-ink p-0.5 rounded transition-colors"
                >
                  <X className="size-3.5" />
                </button>
              ) : null}
            </form>

            {/* Status Pills */}
            <div className="flex items-center gap-1 p-0.5 rounded-lg bg-surface-secondary/70">
              {(
                [
                  { id: 'all', label: `All ${totalKeysCount}` },
                  { id: 'healthy', label: `Healthy ${healthyCount}` },
                  { id: 'issues', label: 'Issues 0' },
                  { id: 'disabled', label: `Disabled ${providers.length - configuredCount}` },
                ] as const
              ).map((st) => (
                <button
                  key={st.id}
                  type="button"
                  onClick={() => setStatusFilter(st.id)}
                  className={cn(
                    'px-2.5 py-1 rounded-md text-xs font-semibold transition-all',
                    statusFilter === st.id
                      ? 'bg-white dark:bg-neutral-900 text-ink shadow-xs'
                      : 'text-ink-muted hover:text-ink'
                  )}
                >
                  {st.label}
                </button>
              ))}
            </div>
          </div>

          {/* Provider Rows List */}
          <div className="space-y-2">
            {filteredProviders.length === 0 ? (
              <Card className="border-dashed p-8 text-center">
                <p className="text-xs text-ink-muted">No providers match the current search or status filter.</p>
              </Card>
            ) : (
              filteredProviders.map((p) => {
                const isExpanded = expandedProvider === p.id;
                const isPrimary = primaryProvider === p.id;
                const status = testStatus[p.id];
                const isConfigured = Boolean(p.configuredOnServer || p.keyless);

                return (
                  <div
                    key={p.id}
                    data-testid={`provider-row-${p.id}`}
                    className={cn(
                      'rounded-xl border transition-all overflow-hidden',
                      isExpanded
                        ? 'border-border bg-surface shadow-sm ring-1 ring-border/50'
                        : 'border-border/60 bg-surface/80 hover:bg-surface'
                    )}
                  >
                    {/* Main Row â€” stacks into two tidy bands below lg, where a
                        single line would crush the provider name against the
                        key count and status pill. */}
                    <div className="p-3.5 flex flex-col gap-2.5 lg:flex-row lg:items-center lg:justify-between lg:gap-4">
                      {/* Left: Switch, Title, Badges */}
                      <div className="flex min-w-0 flex-1 items-center gap-3">
                        {/* On/Off Switch */}
                        <label className="relative inline-flex items-center cursor-pointer">
                          <input
                            type="checkbox"
                            checked={p.enabled !== false && isConfigured}
                            onChange={() => handleToggleProvider(p.id, p.enabled !== false)}
                            className="sr-only peer"
                          />
                          <div className="w-9 h-5 bg-neutral-200 dark:bg-neutral-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-neutral-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-neutral-900 dark:peer-checked:bg-emerald-600"></div>
                        </label>

                        {/* Title and Badges */}
                        <div className="min-w-0">
                          <div className="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1">
                            <span className="text-sm font-bold text-ink">{p.name}</span>
                            {p.hint && (
                              <span className="whitespace-nowrap text-[10px] text-sky-700 dark:text-sky-300 bg-sky-50 dark:bg-sky-950/50 px-2 py-0.5 rounded-md font-medium border border-sky-200 dark:border-sky-800">
                                {p.hint}
                              </span>
                            )}
                            {isPrimary && (
                              <span className="text-[10px] text-purple-700 dark:text-purple-300 bg-purple-50 dark:bg-purple-950/50 px-2 py-0.5 rounded-md font-black tracking-wide border border-purple-200 dark:border-purple-800 uppercase">
                                PRIMARY
                              </span>
                            )}
                            {p.group === 'search' && (
                              <span className="text-[10px] text-amber-700 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/50 px-2 py-0.5 rounded-md font-medium border border-amber-200 dark:border-amber-800">
                                web search
                              </span>
                            )}
                          </div>
                        </div>
                      </div>

                      {/* Right: Key Count, Health Status, Actions */}
                      <div className="flex flex-wrap items-center gap-2 pl-12 lg:pl-0 lg:gap-3">
                        {/* Key Count Badge */}
                        <span className="whitespace-nowrap text-xs font-mono font-semibold px-2 py-0.5 rounded-md bg-surface-secondary text-ink-muted">
                          {p.keysCount || (p.keyless ? 1 : 0)} {p.keysCount === 1 ? 'key' : 'keys'}
                        </span>

                        {/* Operational status pill (4 exact states) */}
                        <span
                          data-testid={`provider-status-${p.id}`}
                          data-provider-state={providerStatePill(p).state}
                          data-credential-source={p.configuredOnServer ? 'server' : p.hasKey ? 'draft' : 'none'}
                          aria-label={`${p.name}: ${providerStatePill(p).label}${
                            p.configuredOnServer ? ' â€” Configured on Server' : ''
                          }`}
                          title={providerStatePill(p).detail}
                          className={cn(
                            'inline-flex items-center gap-1 whitespace-nowrap rounded-md border px-2 py-0.5 text-[11px] font-semibold',
                            providerStatePill(p).tone
                          )}
                        >
                          {providerStatePill(p).label}
                          {providerStatePill(p).state === 'healthy' && p.latencyMs ? (
                            <span className="font-mono text-[10px] opacity-80">{p.latencyMs}ms</span>
                          ) : null}
                        </span>

                        {/* Quick + Add Key Button on Row */}
                        {!isConfigured && (
                          <Button
                            variant="outline"
                            size="xs"
                            onClick={() => handleOpenAddKeyForProvider(p)}
                            className="h-7 text-xs font-semibold hidden lg:inline-flex"
                          >
                            <Plus className="size-3 mr-1" />
                            Add key
                          </Button>
                        )}

                        {/* Live reachability probe */}
                        <Button
                          variant="ghost"
                          size="xs"
                          onClick={() => handleTestProvider(p.id)}
                          loading={testingId === p.id}
                          data-testid={`test-connection-${p.id}`}
                          aria-label={`Test ${p.name} connection`}
                          className="h-7 text-xs text-ink-muted hover:text-ink hidden lg:inline-flex"
                        >
                          <Zap className="size-3 mr-1" />
                          Test Connection
                        </Button>

                        {/* Live reachability probe result badge (visible even when collapsed) */}
                        {status && (
                          <span
                            data-testid={`row-test-result-${p.id}`}
                            className={cn(
                              'inline-flex items-center gap-1 whitespace-nowrap text-[11px] font-mono font-semibold px-2 py-0.5 rounded-md border transition-all animate-in fade-in',
                              status.ok
                                ? 'bg-emerald-50 text-emerald-800 border-emerald-200 dark:bg-emerald-950/50 dark:text-emerald-200 dark:border-emerald-800'
                                : 'bg-rose-50 text-rose-800 border-rose-200 dark:bg-rose-950/50 dark:text-rose-200 dark:border-rose-800'
                            )}
                            title={status.message}
                          >
                            {status.ok ? (
                              <>
                                <CheckCircle2 className="size-3 text-emerald-600 dark:text-emerald-400 shrink-0" />
                                âš¡ {status.latencyMs || 150}ms
                              </>
                            ) : (
                              <>
                                <AlertCircle className="size-3 text-rose-600 dark:text-rose-400 shrink-0" />
                                <span className="truncate max-w-[120px]">{status.message}</span>
                              </>
                            )}
                          </span>
                        )}

                        {/* Expand Accordion Toggle */}
                        <button
                          type="button"
                          data-testid={`expand-provider-${p.id}`}
                          aria-expanded={isExpanded}
                          aria-label={`${isExpanded ? 'Collapse' : 'Expand'} ${p.name} settings`}
                          onClick={() => setExpandedProvider(isExpanded ? null : p.id)}
                          className="p-1 rounded-md text-ink-muted hover:text-ink hover:bg-surface-secondary transition-transform"
                        >
                          {isExpanded ? <ChevronDown className="size-4" /> : <ChevronRight className="size-4" />}
                        </button>
                      </div>
                    </div>

                    {/* Expandable Settings & Direct Inline Key Configuration */}
                    {isExpanded && (
                      <div className="p-4 bg-surface-secondary/40 border-t border-border/50 space-y-4 animate-[fade-in_150ms_ease-out]">
                        {/* Reachability Result */}
                        {status && (
                          <div
                            className={cn(
                              'p-2.5 rounded-lg text-xs flex items-center gap-2',
                              status.ok
                                ? 'bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-200 border border-emerald-200 dark:border-emerald-800'
                                : 'bg-rose-50 dark:bg-rose-950/40 text-rose-800 dark:text-rose-200 border border-rose-200 dark:border-rose-800'
                            )}
                          >
                            {status.ok ? (
                              <CheckCircle2 className="size-4 text-emerald-600 dark:text-emerald-400 shrink-0" />
                            ) : (
                              <AlertCircle className="size-4 text-rose-600 dark:text-rose-400 shrink-0" />
                            )}
                            <span className="font-mono">{status.message}</span>
                          </div>
                        )}

                        <div className="flex flex-wrap items-center gap-2">
                          <Button
                            variant="outline"
                            size="xs"
                            onClick={() => handleTestProvider(p.id)}
                            loading={testingId === p.id}
                            data-testid={`test-connection-inline-${p.id}`}
                            className="h-7 text-xs font-semibold"
                          >
                            <Zap className="size-3 mr-1 text-amber-500" />
                            Test Connection
                          </Button>
                          {testStatus[p.id]?.latencyMs ? (
                            <span
                              data-testid={`latency-badge-${p.id}`}
                              className="text-[11px] font-mono font-semibold px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-800 border border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-200 dark:border-emerald-800"
                            >
                              âš¡ {testStatus[p.id]?.latencyMs}ms
                            </span>
                          ) : null}
                          {cooldowns[p.id] ? (
                            <>
                              <span className="text-[11px] font-mono font-semibold px-2 py-0.5 rounded-md bg-amber-50 text-amber-800 border border-amber-200 dark:bg-amber-950/40 dark:text-amber-200 dark:border-amber-800">
                                âŠ˜ {cooldowns[p.id].remainingSeconds}s remaining
                              </span>
                              <Button
                                variant="ghost"
                                size="xs"
                                onClick={() => {
                                  setCooldownFlushProvider(p.id);
                                  setIsCooldownFlushOpen(true);
                                }}
                                className="h-7 text-xs text-amber-600 hover:bg-amber-50 dark:hover:bg-amber-950/30"
                                title="Flush cooldown for this provider"
                              >
                                <RotateCcw className="size-3 mr-1" />
                                Flush
                              </Button>
                            </>
                          ) : null}
                        </div>

                        {/* Multi-key pool: chips + paste-more editor */}
                        {!isSearchProvider(p) && (
                          <div className="space-y-2" data-testid={`key-pool-${p.id}`}>
                            <label className="text-xs font-semibold text-ink flex items-center gap-1.5">
                              <Layers className="size-3 text-purple-500" />
                              Key Pool
                              <span className="text-[10px] font-normal text-ink-muted">
                                rotate automatically on 429
                              </span>
                            </label>
                            <div className="flex flex-wrap items-center gap-1.5">
                              {Array.from({ length: p.keyless ? 1 : Math.max(0, p.keysCount || 0) }).map((_unused, index) => (
                                <span
                                  key={index}
                                  data-testid={`key-chip-${p.id}-${index}`}
                                  className="inline-flex items-center gap-1 rounded-md border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-[11px] font-semibold text-emerald-800 dark:border-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-200"
                                >
                                  <Shield className="size-2.5" />
                                  {p.keyless ? 'keyless' : `key ${index + 1}`}
                                </span>
                              ))}
                              {!p.keyless && (p.keysCount || 0) === 0 ? (
                                <span className="text-[11px] text-ink-muted">No keys yet â€” paste up to 10 to build a pool.</span>
                              ) : null}
                            </div>
                            <div className="flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
                              <Input
                                value={keyPoolDrafts[p.id] ?? ''}
                                onChange={(e) =>
                                  setKeyPoolDrafts((prev) => ({ ...prev, [p.id]: e.target.value }))
                                }
                                placeholder="Paste additional keys (comma or newline separated)â€¦"
                                aria-label={`${p.name} key pool`}
                                className="h-8 flex-1 text-xs font-mono"
                              />
                              <Button
                                variant="outline"
                                size="xs"
                                onClick={() => handleSaveKeyPool(p.id)}
                                loading={saving}
                                disabled={splitKeyPool(keyPoolDrafts[p.id] || '').length === 0}
                                className="h-8 text-xs font-semibold"
                              >
                                <Plus className="size-3 mr-1" />
                                Add to pool
                              </Button>
                            </div>
                            {splitKeyPool(keyPoolDrafts[p.id] || '').length > 0 ? (
                              <div className="flex flex-wrap gap-1.5">
                                {splitKeyPool(keyPoolDrafts[p.id] || '').map((key, index) => (
                                  <span
                                    key={index}
                                    className="inline-flex items-center gap-1 rounded-md border border-border bg-surface px-2 py-0.5 text-[11px] font-mono text-ink-muted"
                                  >
                                    {key.length > 8 ? `${key.slice(0, 4)}â€¦${key.slice(-3)}` : 'â€¢â€¢â€¢â€¢'}
                                  </span>
                                ))}
                              </div>
                            ) : null}
                          </div>
                        )}

                        <div className="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                          {/* Direct Key Configuration */}
                          <div className="space-y-2">
                            <div className="flex items-center justify-between">
                              <label className="font-semibold text-ink flex items-center gap-1.5">
                                <Key className="size-3 text-amber-500" />
                                Provider API Key
                              </label>
                              {p.docUrl && (
                                <a
                                  href={p.docUrl}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  className="text-[11px] text-brand-600 hover:underline flex items-center gap-0.5 font-medium"
                                >
                                  Get API key <ExternalLink className="size-2.5" />
                                </a>
                              )}
                            </div>

                            <div className="flex items-center gap-2">
                              <div className="relative flex-1">
                                <Input
                                  type={showSecretField[p.id] ? 'text' : 'password'}
                                  id={`provider-key-input-${p.id}`}
                                  name={`provider_key_${p.id}`}
                                  autoComplete="new-password"
                                  data-lpignore="true"
                                  data-1p-ignore="true"
                                  data-bwignore="true"
                                  data-form-type="other"
                                  value={secretInputs[p.id] ?? ''}
                                  onChange={(e) =>
                                    setSecretInputs((prev) => ({ ...prev, [p.id]: e.target.value }))
                                  }
                                  placeholder={
                                    p.configuredOnServer
                                      ? 'â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢ (Active on server)'
                                      : p.keyless
                                      ? 'Keyless gateway (no key required)'
                                      : 'Paste API Key hereâ€¦'
                                  }
                                  className="h-8 text-xs font-mono pr-8"
                                />
                                <button
                                  type="button"
                                  onClick={() =>
                                    setShowSecretField((prev) => ({ ...prev, [p.id]: !prev[p.id] }))
                                  }
                                  className="absolute right-2 top-1/2 -translate-y-1/2 text-ink-muted hover:text-ink text-xs"
                                >
                                  {showSecretField[p.id] ? <EyeOff className="size-3" /> : <Eye className="size-3" />}
                                </button>
                              </div>

                              <Button
                                variant="primary"
                                size="xs"
                                onClick={() => handleSaveSingleKey(p.id)}
                                loading={saving}
                                disabled={!secretInputs[p.id]?.trim()}
                                className="h-8 text-xs font-bold whitespace-nowrap"
                              >
                                Save Key
                              </Button>

                              {p.configuredOnServer && !p.keyless && (
                                <Button
                                  variant="ghost"
                                  size="xs"
                                  onClick={() => handleClearSingleKey(p.id)}
                                  className="h-8 text-xs text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/30"
                                >
                                  Clear
                                </Button>
                              )}
                            </div>
                            <p className="text-[10px] text-ink-muted">
                              Encrypted in MariaDB. Zero client-side leakage.
                            </p>
                          </div>

                          {/* Model Target & Live Discovery */}
                          <div className="space-y-2">
                            <div className="flex items-center justify-between flex-wrap gap-2">
                              <label className="font-semibold text-ink text-xs flex items-center gap-1.5">
                                <Brain className="size-3.5 text-brand-600" />
                                Model Target Configuration
                              </label>
                              <Button
                                variant="ghost"
                                size="xs"
                                onClick={() => handleDiscoverModels(p.id)}
                                loading={discoveringProviderId === p.id}
                                className="h-6 px-2 text-[11px] font-semibold text-brand-600 hover:text-brand-700 hover:bg-brand-50 dark:hover:bg-brand-950/40"
                                title="Query live models directly from upstream endpoint"
                              >
                                <RefreshCw className={cn("size-3 mr-1", discoveringProviderId === p.id && "animate-spin")} />
                                {discoveredModels[p.id]?.length ? `Refresh (${discoveredModels[p.id].length})` : 'Discover Live Models'}
                              </Button>
                            </div>

                            {/* Model Selector / Custom Input */}
                            {discoveredModels[p.id]?.length > 0 && modelInputMode[p.id] !== 'custom' ? (
                              <div className="space-y-1.5">
                                <div className="flex items-center gap-1.5">
                                  <select
                                    value={modelDrafts[p.id] ?? p.defaultModel}
                                    onChange={(e) => setModelDrafts((prev) => ({ ...prev, [p.id]: e.target.value }))}
                                    className="flex-1 h-8 text-xs font-mono rounded-lg border border-border bg-surface px-2.5 text-ink focus:outline-none focus:ring-1 focus:ring-brand-500"
                                  >
                                    {discoveredModels[p.id].map((m) => (
                                      <option key={m.id} value={m.id}>
                                        {m.id} ({m.tier || 'Standard'} Â· {m.contextWindow || '128K'}{m.supportsVision ? ' Â· Vision' : ''})
                                      </option>
                                    ))}
                                  </select>
                                  <Button
                                    variant="outline"
                                    size="xs"
                                    onClick={() => setModelInputMode((prev) => ({ ...prev, [p.id]: 'custom' }))}
                                    className="h-8 px-2 text-[10px] text-ink-muted hover:text-ink"
                                    title="Switch to custom model ID text input"
                                  >
                                    Custom
                                  </Button>
                                </div>
                                <div className="flex items-center gap-1 text-[10px] text-emerald-600 dark:text-emerald-400 font-medium">
                                  <CheckCircle2 className="size-3" />
                                  <span>{discoveredModels[p.id].length} live models discovered from {p.name} endpoint</span>
                                </div>
                              </div>
                            ) : (
                              <div className="space-y-1.5">
                                <div className="flex items-center gap-1.5">
                                  <Input
                                    value={modelDrafts[p.id] ?? p.defaultModel}
                                    onChange={(e) => setModelDrafts((prev) => ({ ...prev, [p.id]: e.target.value }))}
                                    placeholder="e.g. meta/llama-3.2-11b-vision-instruct"
                                    className="h-8 text-xs font-mono bg-surface text-ink"
                                  />
                                  {discoveredModels[p.id]?.length > 0 && (
                                    <Button
                                      variant="outline"
                                      size="xs"
                                      onClick={() => setModelInputMode((prev) => ({ ...prev, [p.id]: 'dropdown' }))}
                                      className="h-8 px-2 text-[10px] text-ink-muted hover:text-ink"
                                      title="Switch back to discovered models dropdown"
                                    >
                                      Discovered
                                    </Button>
                                  )}
                                </div>
                                <p className="text-[10px] text-ink-muted">
                                  Active target model sent to provider for chat completions and evaluations.
                                </p>
                              </div>
                            )}

                            {/* Model Actions: Save Model, Set Primary, Reachability Test */}
                            <div className="pt-1 flex items-center justify-between gap-2 flex-wrap">
                              <div className="flex items-center gap-2">
                                <Button
                                  variant="primary"
                                  size="xs"
                                  onClick={() => handleSaveModel(p.id)}
                                  loading={savingModelId === p.id}
                                  disabled={!modelDrafts[p.id] || modelDrafts[p.id] === p.defaultModel}
                                  className="h-7 text-xs font-semibold"
                                >
                                  <Check className="size-3 mr-1" />
                                  {modelSavedNotice[p.id] ? 'Saved!' : 'Save Model'}
                                </Button>
                                {primaryProvider !== p.id && (
                                  <Button
                                    variant="outline"
                                    size="xs"
                                    onClick={() => setPrimaryProvider(p.id)}
                                    className="h-7 text-xs font-semibold"
                                  >
                                    Set as Primary
                                  </Button>
                                )}
                              </div>
                              <Button
                                variant="secondary"
                                size="xs"
                                onClick={() => handleTestProvider(p.id, undefined, modelDrafts[p.id] || p.defaultModel)}
                                loading={testingId === p.id}
                                className="h-7 text-xs font-semibold"
                              >
                                Reachability Test
                              </Button>

                              {testStatus[p.id] && (
                                <span
                                  className={cn(
                                    'inline-flex items-center gap-1 text-[11px] font-mono font-semibold px-2 py-0.5 rounded-md border animate-in fade-in',
                                    testStatus[p.id].ok
                                      ? 'bg-emerald-50 text-emerald-800 border-emerald-200 dark:bg-emerald-950/50 dark:text-emerald-200 dark:border-emerald-800'
                                      : 'bg-rose-50 text-rose-800 border-rose-200 dark:bg-rose-950/50 dark:text-rose-200 dark:border-rose-800'
                                  )}
                                  title={testStatus[p.id].message}
                                >
                                  {testStatus[p.id].ok ? (
                                    <>
                                      <CheckCircle2 className="size-3 text-emerald-600 dark:text-emerald-400 shrink-0" />
                                      âš¡ {testStatus[p.id].latencyMs || 150}ms
                                    </>
                                  ) : (
                                    <>
                                      <AlertCircle className="size-3 text-rose-600 dark:text-rose-400 shrink-0" />
                                      <span className="truncate max-w-[120px]">{testStatus[p.id].message}</span>
                                    </>
                                  )}
                                </span>
                              )}
                            </div>
                          </div>
                        </div>
                      </div>
                    )}
                  </div>
                );
              })
            )}
          </div>
            )}

          {/* â”€â”€â”€ SUBTAB 2: KEY POOL â”€â”€â”€ */}
          {activeSubTab === 'key-pool' && (
            <div className="space-y-6 pt-2">
              <Card className="border-border/70">
                <CardContent className="p-6 space-y-4">
                  <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div>
                      <h3 className="text-base font-bold text-ink flex items-center gap-2">
                        <Layers className="size-4 text-purple-500" />
                        Multi-Key Pool Management & Load Distribution
                      </h3>
                      <p className="text-xs text-ink-muted mt-1">
                        Manage key pools for high-volume providers. Keys rotate automatically on HTTP 429 rate limits for seamless failover.
                      </p>
                    </div>
                    <Button
                      variant="outline"
                      size="xs"
                      onClick={() => handleCheckAll}
                      loading={checkingAll}
                      className="text-xs shrink-0"
                    >
                      <RefreshCw className={cn("size-3 mr-1", checkingAll && "animate-spin")} />
                      Health Check All Pools
                    </Button>
                  </div>

                  {Object.keys(keyPoolDrafts).length === 0 && providers.filter(p => p.keysCount && p.keysCount > 1).length === 0 ? (
                    <div className="p-8 text-center rounded-xl border border-dashed border-border/60 bg-surface-secondary/30">
                      <Layers className="size-12 text-purple-500 mx-auto mb-3 opacity-50" />
                      <p className="text-xs text-ink-muted">No key pools configured yet. Expand a provider row in the Providers tab and add multiple keys to build a rotation pool.</p>
                    </div>
                  ) : (
                    <div className="space-y-3">
                      <h4 className="text-xs font-bold text-ink">Active Key Pools</h4>
                      <div className="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                        {providers.filter(p => p.keysCount && p.keysCount > 1).map((p) => (
                          <div key={p.id} className="p-4 rounded-xl border border-border bg-surface-secondary/40 space-y-2">
                            <div className="flex items-center justify-between">
                              <span className="font-bold text-xs text-ink">{p.name}</span>
                              <span className="text-[10px] font-mono text-emerald-600 dark:text-emerald-400">{p.keysCount} keys</span>
                            </div>
                            <div className="flex flex-wrap gap-1.5">
                              {Array.from({ length: p.keysCount }).map((_unused, index) => (
                                <span
                                  key={index}
                                  className="inline-flex items-center gap-1 rounded-md border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-[11px] font-semibold text-emerald-800 dark:border-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-200"
                                >
                                  <Shield className="size-2.5" />
                                  key {index + 1}
                                </span>
                              ))}
                            </div>
                            <Button
                              variant="outline"
                              size="xs"
                              onClick={() => { setExpandedProvider(p.id); handleSelectSubTab('providers'); }}
                              className="h-7 text-xs font-semibold w-full"
                            >
                              Manage Pool
                            </Button>
                          </div>
                        ))}
                      </div>

                      {Object.keys(keyPoolDrafts).filter(k => keyPoolDrafts[k]).length > 0 && (
                        <div className="pt-3 border-t border-border/40">
                          <h4 className="text-xs font-bold text-ink mb-2">Pending Pool Changes (Unsaved)</h4>
                          <div className="space-y-2">
                            {Object.entries(keyPoolDrafts).filter(([, v]) => v).map(([providerId, draft]) => {
                              const p = providers.find(item => item.id === providerId);
                              const pool = splitKeyPool(draft);
                              return (
                                <div key={providerId} className="p-3 rounded-lg border border-amber-200 bg-amber-50 dark:bg-amber-950/40 dark:border-amber-800 space-y-1.5">
                                  <div className="flex items-center justify-between">
                                    <span className="font-bold text-xs text-ink">{p?.name || providerId}</span>
                                    <span className="text-[10px] font-mono text-amber-700 dark:text-amber-300">{pool.length} new keys</span>
                                  </div>
                                  <div className="flex flex-wrap gap-1">
                                    {pool.map((key, idx) => (
                                      <span key={idx} className="text-[10px] font-mono px-1.5 py-0.5 rounded bg-surface border border-border text-ink-muted">
                                        {key.length > 8 ? `${key.slice(0, 4)}â€¦${key.slice(-3)}` : 'â€¢â€¢â€¢â€¢'}
                                      </span>
                                    ))}
                                  </div>
                                  <Button
                                    variant="outline"
                                    size="xs"
                                    onClick={() => handleSaveKeyPool(providerId)}
                                    className="h-7 text-xs font-semibold w-full"
                                  >
                                    Save Pool
                                  </Button>
                                </div>
                              );
                            })}
                          </div>
                        </div>
                      )}
                    </div>
                  )}
                </CardContent>
              </Card>
            </div>
          )}

          {/* â”€â”€â”€ SUBTAB 3: METRICS & COOLDOWNS â”€â”€â”€ */}
          {activeSubTab === 'metrics' && (
            <div className="space-y-6 pt-2">
              <Card className="border-border/70">
                <CardContent className="p-6 space-y-4">
                  <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div>
                      <h3 className="text-base font-bold text-ink flex items-center gap-2">
                        <Radio className="size-4 text-emerald-500" />
                        Quota Signals & Real-Time Cooldown Monitor
                      </h3>
                      <p className="text-xs text-ink-muted mt-1">
                        Live telemetry tracking upstream HTTP 429 rate limits, active provider backoff timers, and quota limits.
                      </p>
                    </div>
                    <div className="flex items-center gap-2">
                      <Button
                        variant="outline"
                        size="xs"
                        onClick={() => {
                          setCooldownFlushAll(true);
                          setIsCooldownFlushOpen(true);
                        }}
                        className="text-xs shrink-0"
                      >
                        <RotateCcw className="size-3 mr-1" />
                        Flush Cooldown Now
                      </Button>
                      <Button
                        variant="outline"
                        size="xs"
                        onClick={() => setCooldowns({})}
                        className="text-xs shrink-0"
                      >
                        <RefreshCw className="size-3 mr-1" />
                        Reset Active Cooldowns
                      </Button>
                    </div>
                  </div>

                  {/* Active Cooldowns Banner */}
                  {Object.keys(cooldowns).length === 0 ? (
                    <div className="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center gap-3">
                      <CheckCircle2 className="size-5 text-emerald-500 shrink-0" />
                      <div>
                        <div className="text-xs font-bold text-emerald-800 dark:text-emerald-300">
                          All 74 Providers Healthy â€” Zero Active Cooldowns
                        </div>
                        <div className="text-[11px] text-emerald-700/80 dark:text-emerald-400/80">
                          No upstream providers are currently rate-limited (HTTP 429) or benched. Transparent failover cascade is fully operational.
                        </div>
                      </div>
                    </div>
                  ) : (
                    <div className="space-y-2">
                      <div className="text-xs font-bold text-amber-700 dark:text-amber-400 flex items-center gap-1.5">
                        <AlertCircle className="size-3.5" />
                        Active Provider Cooldowns ({Object.keys(cooldowns).length})
                      </div>
                      <div className="grid gap-2 sm:grid-cols-2">
                        {Object.entries(cooldowns).map(([prov, info]) => (
                          <div
                            key={prov}
                            className="p-3 rounded-lg border border-amber-500/30 bg-amber-500/5 flex items-center justify-between text-xs"
                          >
                            <div>
                              <div className="font-bold text-ink uppercase tracking-wider">{prov}</div>
                              <div className="text-[11px] text-ink-muted">{info.reason || 'Rate limit backoff (429)'}</div>
                            </div>
                            <span className="font-mono text-xs font-bold px-2 py-0.5 rounded bg-amber-500/20 text-amber-800 dark:text-amber-300">
                              {info.remainingSeconds}s remaining
                            </span>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}

                  {/* Provider Quota Matrix */}
                  <div className="pt-3">
                    <h4 className="text-xs font-bold text-ink mb-2">Provider Quota & Throughput Reference</h4>
                    <div className="rounded-xl border border-border/70 overflow-hidden text-xs">
                      <table className="w-full text-left">
                        <thead className="bg-surface-secondary/70 border-b border-border text-[11px] font-semibold text-ink-muted">
                          <tr>
                            <th className="py-2.5 px-3">Platform</th>
                            <th className="py-2.5 px-3">Tier</th>
                            <th className="py-2.5 px-3">Free Rate Limits</th>
                            <th className="py-2.5 px-3">Context Window</th>
                            <th className="py-2.5 px-3 text-right">Status</th>
                          </tr>
                        </thead>
                        <tbody className="divide-y divide-border/40">
                          {providers.slice(0, 15).map((p) => (
                            <tr key={p.id} className="hover:bg-surface-secondary/40 transition-colors">
                              <td className="py-2.5 px-3 font-semibold text-ink flex items-center gap-2">
                                <span className="size-2 rounded-full bg-emerald-500" />
                                {p.name}
                              </td>
                              <td className="py-2.5 px-3">
                                <span className={cn(
                                  'text-[10px] font-bold px-1.5 py-0.5 rounded',
                                  FRONTIER_PROVIDER_IDS.has(p.id)
                                    ? 'bg-purple-500/10 text-purple-700 dark:text-purple-300'
                                    : 'bg-neutral-100 dark:bg-neutral-800 text-ink-muted'
                                )}>
                                  {FRONTIER_PROVIDER_IDS.has(p.id) ? 'Frontier' : 'Community Mesh'}
                                </span>
                              </td>
                              <td className="py-2.5 px-3 font-mono text-ink-muted">
                                {p.id === 'groq' ? '30 RPM Â· 14,400 RPD' :
                                 p.id === 'cerebras' ? '30 RPM Â· 1M TPD' :
                                 p.id === 'gemini' ? '15 RPM Â· 1,500 RPD' :
                                 p.id === 'nvidia' ? '40 RPM Â· 5K credits' :
                                 p.id === 'ovh' ? 'Keyless (Unlimited Mesh)' :
                                 p.id === 'kilo' ? '200 req/hr (Keyless)' : 'Dynamic mesh quota'}
                              </td>
                              <td className="py-2.5 px-3 font-mono text-ink-muted">
                                {p.id === 'gemini' ? '1,000,000' :
                                 p.id === 'groq' ? '128,000' :
                                 p.id === 'nvidia' ? '128,000' :
                                 p.id === 'ovh' ? '131,072' : '32,768 - 128,000'}
                              </td>
                              <td className="py-2.5 px-3 text-right">
                                <span className="font-semibold text-[11px] text-emerald-600 dark:text-emerald-400">
                                  â— Available
                                </span>
                              </td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                </CardContent>
              </Card>
            </div>
          )}

          {/* â”€â”€â”€ SUBTAB 4: UNIFIED GATEWAY â”€â”€â”€ */}
          {activeSubTab === 'unified-gateway' && (
            <div className="space-y-6 pt-2">
              <Card className="border-border/70">
                <CardContent className="p-6 space-y-4">
                  <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div>
                      <h3 className="text-base font-bold text-ink flex items-center gap-2">
                        <Terminal className="size-4 text-brand-600" />
                        Anthropic Wire Protocol & Claude Model Translation
                      </h3>
                      <p className="text-xs text-ink-muted mt-1">
                        FreeLLMAPI natively implements Anthropic's <code className="font-mono">/v1/messages</code> wire protocol, allowing Claude Desktop and Claude Code CLI to communicate with any open-source or frontier model in the mesh.
                      </p>
                    </div>
                    <Button
                      variant="outline"
                      size="xs"
                      onClick={() => setActiveTab('claude')}
                      className="text-xs shrink-0"
                    >
                      <Terminal className="size-3 mr-1" />
                      Open Claude Studio
                    </Button>
                  </div>

                  <div className="grid gap-4 sm:grid-cols-2 pt-2">
                    <div className="p-4 rounded-xl border border-border bg-surface-secondary/40 space-y-2">
                      <div className="text-xs font-bold text-ink">Claude Model Family Aliases</div>
                      <div className="space-y-1.5 text-xs text-ink-muted">
                        <div className="flex justify-between border-b border-border/40 pb-1">
                          <span className="font-mono text-ink">claude-3-7-sonnet</span>
                          <span className="font-semibold text-purple-600 dark:text-purple-400">Routes to Frontier 70B Mesh</span>
                        </div>
                        <div className="flex justify-between border-b border-border/40 pb-1">
                          <span className="font-mono text-ink">claude-3-5-haiku</span>
                          <span className="font-semibold text-emerald-600 dark:text-emerald-400">Routes to Cerebras/Groq Ultra-Fast</span>
                        </div>
                        <div className="flex justify-between">
                          <span className="font-mono text-ink">claude-3-opus</span>
                          <span className="font-semibold text-indigo-600 dark:text-indigo-400">Routes to DeepSeek R1 / V3 Reasoning</span>
                        </div>
                      </div>
                    </div>

                    <div className="p-4 rounded-xl border border-border bg-surface-secondary/40 space-y-2">
                      <div className="text-xs font-bold text-ink">Terminal Environment Setup</div>
                      <div className="relative p-2.5 rounded bg-neutral-950 text-white font-mono text-[11px] overflow-x-auto">
                        <pre>
export ANTHROPIC_BASE_URL="http://localhost:8080/v1"
export ANTHROPIC_API_KEY="free-ime365-unified-key"
                        </pre>
                        <button
                          type="button"
                          onClick={() => handleCopy('export ANTHROPIC_BASE_URL="http://localhost:8080/v1"\nexport ANTHROPIC_API_KEY="free-ime365-unified-key"', 'anthropic-env')}
                          className="absolute right-2 top-2 p-1 rounded bg-neutral-800 text-neutral-300 hover:text-white"
                        >
                          {copiedText === 'anthropic-env' ? <Check className="size-3 text-emerald-400" /> : <Copy className="size-3" />}
                        </button>
                      </div>
                    </div>
                  </div>
                </CardContent>
              </Card>
            </div>
          )}

          {/* â”€â”€â”€ SUBTAB 5: MODEL DISCOVERY â”€â”€â”€ */}
          {activeSubTab === 'discovery' && (
            <div className="space-y-6 pt-2">
              <Card className="border-border/70">
                <CardContent className="p-6 space-y-4">
                  <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div>
                      <h3 className="text-base font-bold text-ink flex items-center gap-2">
                        <Sparkles className="size-4 text-purple-600" />
                        Dynamic Live Model Discovery & Catalog Sync
                      </h3>
                      <p className="text-xs text-ink-muted mt-1">
                        Query live models directly from upstream provider endpoints. Discover available models, context windows, vision support, and pricing tiers in real-time.
                      </p>
                    </div>
                    <Button
                      variant="primary"
                      size="xs"
                      onClick={handleDiscoverAllModels}
                      loading={discoveringAllModels}
                      className="h-8 text-xs font-semibold"
                    >
                      <RefreshCw className={cn("size-3.5 mr-1.5", discoveringAllModels && "animate-spin")} />
                      Discover All Models
                    </Button>
                  </div>

                  {/* Discovered Models Summary */}
                  {Object.keys(discoveredModels).length > 0 && (
                    <div className="space-y-3">
                      <h4 className="text-xs font-bold text-ink">Discovered Models by Provider</h4>
                      <div className="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                        {Object.entries(discoveredModels).map(([providerId, models]) => {
                          const provider = providers.find(p => p.id === providerId);
                          return (
                            <div key={providerId} className="p-4 rounded-xl border border-border bg-surface-secondary/40 space-y-2">
                              <div className="flex items-center justify-between">
                                <span className="font-bold text-xs text-ink">{provider?.name || providerId}</span>
                                <span className="text-[10px] font-mono text-emerald-600 dark:text-emerald-400">{models.length} models</span>
                              </div>
                              <div className="space-y-1 max-h-40 overflow-y-auto">
                                {models.map((m) => (
                                  <div key={m.id} className="flex items-center justify-between text-[10px] p-1.5 rounded bg-surface border border-border/40">
                                    <span className="font-mono text-ink truncate max-w-[160px]">{m.id}</span>
                                    <span className="text-ink-muted flex items-center gap-1">
                                      {m.tier && <span className="px-1 py-0.2 rounded text-[9px] font-semibold bg-purple-50 text-purple-700 dark:bg-purple-950/40 dark:text-purple-300">{m.tier}</span>}
                                      {m.contextWindow && <span className="text-[9px] font-mono">{m.contextWindow}</span>}
                                      {m.supportsVision && <span className="px-1 py-0.2 rounded text-[9px] font-semibold bg-sky-50 text-sky-700 dark:bg-sky-950/40 dark:text-sky-300">vision</span>}
                                    </span>
                                  </div>
                                ))}
                              </div>
                            </div>
                          );
                        })}
                      </div>
                    </div>
                  )}

                  {Object.keys(discoveredModels).length === 0 && (
                    <div className="p-8 text-center rounded-xl border border-dashed border-border/60 bg-surface-secondary/30">
                      <Sparkles className="size-12 text-purple-500 mx-auto mb-3 opacity-50" />
                      <p className="text-xs text-ink-muted">No models discovered yet. Click "Discover All Models" to query live endpoints from all configured and keyless providers.</p>
                    </div>
                  )}
                </CardContent>
              </Card>
            </div>
          )}
        </div>
      )}

      {/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */}
      {/* â”€â”€â”€ TAB 2: MODELS & FALLBACK CHAINS (Matching FreeLLMAPI Screen 2) â”€â”€â”€ */}
      {/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */}
      {activeTab === 'models' && (
        <div className="space-y-6">
          {/* Fallback Chains Card */}
          <Card className="border-border/70">
            <CardContent className="p-5 space-y-4">
              <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div>
                  <h3 className="text-base font-bold text-ink flex items-center gap-2">
                    <Layers className="size-4 text-brand-600" />
                    Fallback Chains & Multi-Model Cascade
                  </h3>
                  <p className="text-xs text-ink-muted">
                    Ordered cascade of models. If a provider hits 429 quota or times out, requests automatically failover.
                  </p>
                </div>

                <div className="flex items-center gap-2 flex-wrap">
                  <Button
                    variant="outline"
                    size="xs"
                    onClick={handleDiscoverAllModels}
                    loading={discoveringAllModels}
                    className="h-8 text-xs font-semibold"
                    title="Query live models from all configured and keyless providers"
                  >
                    <RefreshCw className={cn("size-3.5 mr-1.5", discoveringAllModels && "animate-spin")} />
                    Discover All Models
                  </Button>
                  <Button
                    variant="primary"
                    size="xs"
                    onClick={handleSaveFallbackChain}
                    loading={savingChain}
                    className="h-8 text-xs font-semibold"
                  >
                    <Check className="size-3.5 mr-1.5" />
                    {chainSavedSuccess ? 'Saved to DB!' : 'Save Fallback Chain'}
                  </Button>
                </div>
              </div>

              {/* Chain Pills */}
              <div className="flex items-center gap-2 flex-wrap">
                {chains.map((chain) => (
                  <button
                    key={chain.id}
                    type="button"
                    onClick={() => setActiveChainId(chain.alias)}
                    className={cn(
                      'px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all border flex items-center gap-2',
                      activeChainId === chain.alias
                        ? 'border-neutral-900 bg-neutral-900 text-white dark:border-white dark:bg-white dark:text-neutral-900 shadow-sm'
                        : 'border-border bg-surface text-ink hover:bg-surface-secondary'
                    )}
                  >
                    <span>{chain.alias}</span>
                    <span className="text-[10px] opacity-75 font-mono">
                      ({chain.modelsCount} models)
                    </span>
                  </button>
                ))}
              </div>
            </CardContent>
          </Card>

          {/* Model Filter Controls */}
          <div className="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
            {/* Search â€” isolated in semantic form with search type and anti-autofill guardrails */}
            <form
              role="search"
              onSubmit={(e) => e.preventDefault()}
              autoComplete="off"
              className="relative w-full sm:w-80"
            >
              <Search className="size-3.5 text-ink-muted absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" />
              <Input
                type="search"
                id="ai-model-search-input"
                name="ai_model_search_query"
                autoComplete="off"
                autoCorrect="off"
                spellCheck={false}
                data-lpignore="true"
                data-1p-ignore="true"
                data-bwignore="true"
                data-form-type="other"
                value={modelSearch}
                onChange={(e) => setModelSearch(e.target.value)}
                placeholder="Search models, providers, context..."
                className="pl-8 pr-8 h-8 text-xs"
              />
              {modelSearch ? (
                <button
                  type="button"
                  aria-label="Clear model search"
                  onClick={() => setModelSearch('')}
                  className="absolute right-2.5 top-1/2 -translate-y-1/2 text-ink-muted hover:text-ink p-0.5 rounded transition-colors"
                >
                  <X className="size-3.5" />
                </button>
              ) : null}
            </form>

            {/* Context Chips & Capabilities */}
            <div className="flex items-center gap-2 flex-wrap">
              <div className="flex items-center gap-1 p-0.5 rounded-lg bg-surface-secondary/70">
                {(
                  [
                    { id: 'any', label: 'Any context' },
                    { id: '32k', label: '32K+' },
                    { id: '128k', label: '128K+' },
                    { id: '1m', label: '1M+' },
                  ] as const
                ).map((c) => (
                  <button
                    key={c.id}
                    type="button"
                    onClick={() => setContextFilter(c.id)}
                    className={cn(
                      'px-2.5 py-1 rounded-md text-xs font-semibold transition-all',
                      contextFilter === c.id
                        ? 'bg-white dark:bg-neutral-900 text-ink shadow-xs'
                        : 'text-ink-muted hover:text-ink'
                    )}
                  >
                    {c.label}
                  </button>
                ))}
              </div>

              <button
                type="button"
                onClick={() => setFilterVision(!filterVision)}
                className={cn(
                  'px-3 py-1 rounded-lg text-xs font-semibold border transition-all',
                  filterVision
                    ? 'border-brand-500 bg-brand-50 text-brand-700 dark:bg-brand-950/40 dark:text-brand-300'
                    : 'border-border text-ink-muted hover:text-ink'
                )}
              >
                Vision
              </button>

              <button
                type="button"
                onClick={() => setFilterTools(!filterTools)}
                className={cn(
                  'px-3 py-1 rounded-lg text-xs font-semibold border transition-all',
                  filterTools
                    ? 'border-brand-500 bg-brand-50 text-brand-700 dark:bg-brand-950/40 dark:text-brand-300'
                    : 'border-border text-ink-muted hover:text-ink'
                )}
              >
                Tools
              </button>

              <div className="h-4 w-px bg-border mx-1" />

              <Button variant="ghost" size="xs" onClick={handleEnableAllModels} className="h-7 text-xs">
                Enable all
              </Button>
              <Button variant="ghost" size="xs" onClick={handleDisableAllModels} className="h-7 text-xs">
                Disable all
              </Button>
            </div>
          </div>

          {/* Multi-Metric Model Table */}
          <div className="rounded-xl border border-border bg-surface overflow-hidden shadow-xs">
            <div className="overflow-x-auto">
              <table className="w-full text-left text-xs">
                <thead className="bg-surface-secondary/60 text-ink-muted uppercase tracking-wider text-[10px] font-bold border-b border-border">
                  <tr>
                    <th className="py-3 px-4 w-12 text-center">On</th>
                    <th className="py-3 px-4">Model</th>
                    <th className="py-3 px-3">RPM</th>
                    <th className="py-3 px-3">Context</th>
                    <th className="py-3 px-4 min-w-[130px]">Reliability</th>
                    <th className="py-3 px-4 min-w-[130px]">Speed</th>
                    <th className="py-3 px-4 min-w-[130px]">Intelligence</th>
                    <th className="py-3 px-3">Guardrails</th>
                    <th className="py-3 px-4 text-right">Score</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-border/50">
                  {filteredModels.map((m) => (
                    <tr
                      key={m.id}
                      className={cn(
                        'hover:bg-surface-secondary/40 transition-colors',
                        !m.enabled && 'opacity-60 bg-surface-secondary/10'
                      )}
                    >
                      {/* On Switch */}
                      <td className="py-3 px-4 text-center">
                        <input
                          type="checkbox"
                          checked={m.enabled}
                          onChange={() => toggleModelInChain(m.id)}
                          className="size-4 rounded text-neutral-900 cursor-pointer"
                        />
                      </td>

                      {/* Model & Providers */}
                      <td className="py-3 px-4">
                        <div className="font-bold text-ink">{m.name}</div>
                        <div className="text-[11px] text-ink-muted flex items-center gap-1.5 mt-0.5">
                          <span>{m.providersText}</span>
                          {m.supportsVision && (
                            <span className="text-[9px] px-1 rounded bg-sky-50 text-sky-700 dark:bg-sky-950/60 dark:text-sky-300 font-semibold">
                              vision
                            </span>
                          )}
                          {m.supportsTools && (
                            <span className="text-[9px] px-1 rounded bg-purple-50 text-purple-700 dark:bg-purple-950/60 dark:text-purple-300 font-semibold">
                              tools
                            </span>
                          )}
                        </div>
                      </td>

                      {/* RPM */}
                      <td className="py-3 px-3 font-mono text-[11px] text-ink">{m.rpm}</td>

                      {/* Context Window */}
                      <td className="py-3 px-3 font-mono text-[11px] text-ink">{m.contextWindow}</td>

                      {/* Reliability Progress Bar */}
                      <td className="py-3 px-4">
                        <div className="flex items-center gap-2">
                          <div className="flex-1 h-2 rounded-full bg-neutral-200 dark:bg-neutral-800 overflow-hidden">
                            <div
                              className="h-full bg-emerald-500 rounded-full transition-all"
                              style={{ width: `${m.reliabilityScore}%` }}
                            />
                          </div>
                          <span className="font-mono text-[10px] w-7 text-right text-ink-muted">
                            {m.reliabilityScore}%
                          </span>
                        </div>
                      </td>

                      {/* Speed Progress Bar */}
                      <td className="py-3 px-4">
                        <div className="flex items-center gap-2">
                          <div className="flex-1 h-2 rounded-full bg-neutral-200 dark:bg-neutral-800 overflow-hidden">
                            <div
                              className="h-full bg-sky-500 rounded-full transition-all"
                              style={{ width: `${m.speedScore}%` }}
                            />
                          </div>
                          <span className="font-mono text-[10px] w-7 text-right text-ink-muted">
                            {m.speedScore}%
                          </span>
                        </div>
                      </td>

                      {/* Intelligence Progress Bar */}
                      <td className="py-3 px-4">
                        <div className="flex items-center gap-2">
                          <div className="flex-1 h-2 rounded-full bg-neutral-200 dark:bg-neutral-800 overflow-hidden">
                            <div
                              className="h-full bg-purple-500 rounded-full transition-all"
                              style={{ width: `${m.intelligenceScore}%` }}
                            />
                          </div>
                          <span className="font-mono text-[10px] w-7 text-right text-ink-muted">
                            {m.intelligenceScore}%
                          </span>
                        </div>
                      </td>

                      {/* Guardrails */}
                      <td className="py-3 px-3 text-ink-muted font-mono">{m.guardrails}</td>

                      {/* Composite Score */}
                      <td className="py-3 px-4 text-right">
                        <div className="font-mono font-bold text-ink">{m.compositeScore.toFixed(3)}</div>
                        {m.scoreSubtitle && (
                          <div className="text-[10px] text-ink-muted">{m.scoreSubtitle}</div>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      )}

      {/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */}
      {/* â”€â”€â”€ TAB 3: CLAUDE CODE & AGENTS â”€â”€â”€ */}
      {/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */}
      {activeTab === 'claude' && (
        <div className="space-y-6">
          <Card className="border-border/70">
            <CardContent className="p-6 space-y-4">
              <h3 className="text-base font-bold text-ink flex items-center gap-2">
                <Terminal className="size-4 text-brand-600" />
                Claude Code CLI & Agent Proxy Configuration
              </h3>
              <p className="text-xs text-ink-muted">
                Run Claude Code and Anthropic SDK agents against all 74 free and high-permeability providers using the FreeLLMAPI wire proxy.
              </p>

              <div className="space-y-3 pt-2">
                <div className="text-xs font-semibold text-ink">
                  1. Set Environment Variables in Terminal:
                </div>
                <div className="relative p-3 rounded-lg bg-neutral-950 text-white font-mono text-xs overflow-x-auto">
                  <pre>
                    export ANTHROPIC_BASE_URL="http://localhost:8080/v1"{'\n'}
                    export ANTHROPIC_API_KEY="free-ime365-unified-key"
                  </pre>
                  <button
                    type="button"
                    onClick={() =>
                      handleCopy(
                        'export ANTHROPIC_BASE_URL="http://localhost:8080/v1"\nexport ANTHROPIC_API_KEY="free-ime365-unified-key"',
                        'cli-env'
                      )
                    }
                    className="absolute right-3 top-3 p-1.5 rounded bg-neutral-800 text-neutral-300 hover:text-white"
                  >
                    {copiedText === 'cli-env' ? <Check className="size-3.5 text-emerald-400" /> : <Copy className="size-3.5" />}
                  </button>
                </div>

                <div className="text-xs font-semibold text-ink mt-4">
                  2. Launch Claude Code CLI:
                </div>
                <div className="relative p-3 rounded-lg bg-neutral-950 text-white font-mono text-xs overflow-x-auto">
                  <pre>claude --model auto:free-claude-code</pre>
                  <button
                    type="button"
                    onClick={() => handleCopy('claude --model auto:free-claude-code', 'cli-launch')}
                    className="absolute right-3 top-3 p-1.5 rounded bg-neutral-800 text-neutral-300 hover:text-white"
                  >
                    {copiedText === 'cli-launch' ? <Check className="size-3.5 text-emerald-400" /> : <Copy className="size-3.5" />}
                  </button>
                </div>
              </div>
            </CardContent>
          </Card>
        </div>
      )}

      {/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */}
      {/* â”€â”€â”€ TAB 4: PLAYGROUND â”€â”€â”€ */}
      {/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */}
      {activeTab === 'playground' && (
        <div className="space-y-6">
          <Card className="border-border/70">
            <CardContent className="p-6 space-y-4">
              <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div>
                  <h3 className="text-base font-bold text-ink flex items-center gap-2">
                    <Sparkles className="size-4 text-purple-600" />
                    AI Multi-Provider Playground
                  </h3>
                  <p className="text-xs text-ink-muted">
                    Test live completions against any registered provider or fallback chain.
                  </p>
                </div>

                <div className="flex items-center gap-2">
                  <label className="text-xs font-semibold text-ink">Target Model / Chain:</label>
                  <select
                    value={playgroundModel}
                    onChange={(e) => setPlaygroundModel(e.target.value)}
                    className="h-8 text-xs font-semibold rounded-lg border border-border bg-surface px-2.5 text-ink focus:outline-none focus:ring-1 focus:ring-brand-500"
                  >
                    <optgroup label="Dynamic Failover & Takeover Chains">
                      <option value="auto:fastest">auto:fastest (Fast & Intelligent Active Takeover)</option>
                      <option value="auto:free-claude-code">auto:free-claude-code (Frontier 70B & Fast Mesh)</option>
                      <option value="auto:default">auto:default (Smart Adaptive Dynamic Chain)</option>
                    </optgroup>
                    <optgroup label="Active Provider Target Models">
                      {providers
                        .filter((p) => p.configuredOnServer || p.keyless)
                        .map((p) => (
                          <option key={p.id} value={p.defaultModel}>
                            {p.name}: {p.defaultModel}
                          </option>
                        ))}
                    </optgroup>
                    {Object.entries(discoveredModels).length > 0 && (
                      <optgroup label="Live Discovered Models">
                        {Object.entries(discoveredModels).flatMap(([pId, mList]) =>
                          mList.map((m) => (
                            <option key={`${pId}-${m.id}`} value={m.id}>
                              [{pId.toUpperCase()}] {m.id} ({m.tier || 'Standard'})
                            </option>
                          ))
                        )}
                      </optgroup>
                    )}
                  </select>
                </div>
              </div>

              {/* Execution Controls: Temperature & Max Tokens */}
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 p-3 rounded-xl bg-surface-secondary/50 border border-border/60">
                <div className="space-y-1">
                  <div className="flex items-center justify-between text-xs">
                    <span className="font-semibold text-ink">Temperature:</span>
                    <span className="font-mono text-ink-muted">{playgroundTemperature.toFixed(1)}</span>
                  </div>
                  <input
                    type="range"
                    min="0"
                    max="1"
                    step="0.1"
                    value={playgroundTemperature}
                    onChange={(e) => setPlaygroundTemperature(parseFloat(e.target.value))}
                    className="w-full accent-neutral-900 dark:accent-white cursor-pointer"
                  />
                  <div className="flex justify-between text-[10px] text-ink-muted">
                    <span>0.0 (Precise / ATS)</span>
                    <span>1.0 (Creative)</span>
                  </div>
                </div>

                <div className="space-y-1">
                  <div className="flex items-center justify-between text-xs">
                    <span className="font-semibold text-ink">Max Completion Tokens:</span>
                    <span className="font-mono text-ink-muted">{playgroundMaxTokens}</span>
                  </div>
                  <input
                    type="number"
                    min="50"
                    max="4000"
                    step="50"
                    value={playgroundMaxTokens}
                    onChange={(e) => setPlaygroundMaxTokens(parseInt(e.target.value) || 500)}
                    className="w-full h-7 text-xs font-mono rounded border border-border bg-surface px-2 text-ink"
                  />
                  <p className="text-[10px] text-ink-muted">Upper limit on generation length</p>
                </div>
              </div>

              {/* Autonomous Candidate Task Presets */}
              <div className="space-y-1.5">
                <label className="text-xs font-semibold text-ink flex items-center justify-between">
                  <span>Candidate Task Presets (1-Click Test)</span>
                  <span className="text-[10px] text-ink-muted">Selects optimal prompt & autonomous model</span>
                </label>
                <div className="flex flex-wrap items-center gap-2">
                  {[
                    {
                      label: 'ðŸ“„ Cover Letter Draft',
                      model: 'auto:default',
                      prompt: 'Write a 3-paragraph compelling cover letter for a Senior Cloud Solutions Architect applying at Google, highlighting Kubernetes and distributed systems expertise.',
                    },
                    {
                      label: 'ðŸ‘¤ Executive Bio',
                      model: 'auto:default',
                      prompt: 'Generate an authoritative, ATS-optimized 2-paragraph executive summary for a Principal Full Stack Engineer with 10 years of experience.',
                    },
                    {
                      label: 'ðŸ’¼ Technical Interview Question',
                      model: 'auto:default',
                      prompt: 'Act as an interviewer at Netflix. Ask a challenging behavioral & system design question for a Senior Staff Engineer regarding handling multi-region failovers.',
                    },
                    {
                      label: 'âš¡ Autocomplete Bullet',
                      model: 'auto:default',
                      prompt: 'Enhance this resume bullet: "helped build backend api with nodejs and postgres" into an impactful, metric-driven statement.',
                    },
                  ].map((preset, idx) => (
                    <button
                      key={idx}
                      type="button"
                      onClick={() => {
                        setPlaygroundPrompt(preset.prompt);
                        setPlaygroundModel(preset.model);
                      }}
                      className="px-2.5 py-1 rounded-lg text-xs font-semibold border border-border/70 bg-surface hover:bg-surface-secondary text-ink transition-all hover:border-brand-500/50"
                    >
                      {preset.label}
                    </button>
                  ))}
                </div>
              </div>

              <div>
                <label className="text-xs font-semibold text-ink block mb-1">Prompt</label>
                <textarea
                  value={playgroundPrompt}
                  onChange={(e) => setPlaygroundPrompt(e.target.value)}
                  rows={4}
                  className="w-full text-xs font-mono p-3 rounded-lg border border-border bg-surface text-ink focus:outline-none focus:ring-2 focus:ring-brand-500"
                  placeholder="Enter prompt here..."
                />
              </div>

              <div className="flex justify-end items-center gap-3">
                {playgroundLatency !== null && (
                  <span className="text-xs font-mono text-emerald-600 dark:text-emerald-400 font-semibold flex items-center gap-1">
                    <Zap className="size-3" />
                    Probe completed in {playgroundLatency}ms
                  </span>
                )}
                <Button
                  variant="primary"
                  size="sm"
                  onClick={handleRunPlayground}
                  loading={playgroundLoading}
                  className="h-8 text-xs font-bold"
                >
                  <Play className="size-3 mr-1.5" />
                  Run Completion
                </Button>
              </div>

              {playgroundOutput && (
                <div className="pt-2 space-y-2">
                  <div className="flex items-center justify-between">
                    <label className="text-xs font-semibold text-ink flex items-center gap-2 flex-wrap">
                      <span>Response Output</span>
                      <span className="font-mono text-[10px] text-ink-muted bg-surface-secondary px-1.5 py-0.5 rounded border border-border">
                        {playgroundModel}
                      </span>
                      {playgroundActiveMeta?.provider && (
                        <span className="font-mono text-[10px] text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 px-2 py-0.5 rounded border border-emerald-500/30 flex items-center gap-1 font-semibold">
                          <Zap className="size-2.5 text-emerald-500 animate-pulse" />
                          {playgroundActiveMeta.provider.toUpperCase()} Â· {playgroundActiveMeta.model} ({playgroundActiveMeta.latency}ms)
                        </span>
                      )}
                    </label>
                    <Button
                      variant="ghost"
                      size="xs"
                      onClick={() => handleCopy(playgroundOutput, 'playground-out')}
                      className="h-6 text-[11px]"
                    >
                      {copiedText === 'playground-out' ? (
                        <>
                          <Check className="size-3 text-emerald-500 mr-1" />
                          Copied
                        </>
                      ) : (
                        <>
                          <Copy className="size-3 mr-1" />
                          Copy Response
                        </>
                      )}
                    </Button>
                  </div>
                  <div className="p-4 rounded-lg bg-surface-secondary border border-border/80 font-mono text-xs text-ink whitespace-pre-wrap max-h-96 overflow-y-auto">
                    {playgroundOutput}
                  </div>
                </div>
              )}
            </CardContent>
          </Card>
        </div>
      )}

      {/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */}
      {/* â”€â”€â”€ ADD KEY MODAL (Matching FreeLLMAPI Screen 3 Exactly) â”€â”€â”€ */}
      {/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */}
      {isAddKeyOpen && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs animate-[fade-in_150ms_ease-out]">
          <div
            ref={modalRef}
            role="dialog"
            aria-modal="true"
            aria-labelledby="add-key-dialog-title"
            data-testid="add-key-dialog"
            className="relative flex max-h-[90dvh] w-full max-w-lg flex-col rounded-2xl bg-surface border border-border shadow-2xl p-6 space-y-4 overflow-y-auto"
          >
            {/* Header */}
            <div className="flex items-center justify-between border-b border-border/50 pb-3">
              <h2 id="add-key-dialog-title" className="text-lg font-bold text-ink">Add key</h2>
              <button
                type="button"
                data-testid="modal-close"
                aria-label="Close add key dialog"
                onClick={() => {
                  setIsAddKeyOpen(false);
                  setIsComboboxOpen(false);
                }}
                className="p-1 rounded-md text-ink-muted hover:text-ink transition-colors"
              >
                <X className="size-4" />
              </button>
            </div>

            {/* Segmented Control (Provider key / Import file / Custom endpoint) */}
            <div className="flex items-center gap-1.5 p-1 rounded-xl bg-surface-secondary">
              {(
                [
                  { id: 'key', label: 'Provider key' },
                  { id: 'import', label: 'Import file' },
                  { id: 'endpoint', label: 'Custom endpoint' },
                ] as const
              ).map((tab) => (
                <button
                  key={tab.id}
                  type="button"
                  onClick={() => setModalTab(tab.id)}
                  className={cn(
                    'flex-1 py-1.5 rounded-lg text-xs font-semibold transition-all text-center',
                    modalTab === tab.id
                      ? 'bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 shadow-xs'
                      : 'text-ink-muted hover:text-ink'
                  )}
                >
                  {tab.label}
                </button>
              ))}
            </div>

            {/* TAB 1: PROVIDER KEY */}
            {modalTab === 'key' && (
              <div className="space-y-3.5">
                {/* Platform Selector Combobox */}
                <div className="space-y-1.5" ref={comboboxRef}>
                  <div className="flex items-center justify-between">
                    <label className="text-xs font-semibold text-ink">Platform</label>
                    <span className="text-[11px] text-ink-muted">74 platforms supported</span>
                  </div>

                  <div className="relative">
                    <button
                      type="button"
                      data-testid="platform-selector"
                      aria-haspopup="listbox"
                      aria-expanded={isComboboxOpen}
                      aria-label="Select provider platform"
                      onClick={() => setIsComboboxOpen(!isComboboxOpen)}
                      className={cn(
                        'flex h-9 w-full items-center justify-between rounded-lg border bg-surface px-3 text-xs outline-none transition-colors hover:bg-surface-secondary focus:ring-2 focus:ring-neutral-900 dark:focus:ring-white',
                        modalSelectedPlatform ? 'border-neutral-900 dark:border-white font-bold' : 'border-border text-ink-muted'
                      )}
                    >
                      <span className={modalSelectedPlatform ? 'text-ink font-bold' : 'text-ink-muted'}>
                        {modalSelectedPlatform ? modalSelectedPlatform.label : 'Select a platformâ€¦'}
                      </span>
                      <ChevronsUpDown className="size-3.5 text-ink-muted" />
                    </button>

                    {/* Popover Dropdown Menu */}
                    {isComboboxOpen && (
                      <div
                        data-testid="platform-listbox-panel"
                        className="mt-1 w-full rounded-xl border border-border bg-surface shadow-sm overflow-hidden animate-[fade-in_100ms_ease-out]"
                      >
                        {/* Search Input */}
                        <div className="p-2 border-b border-border/60 bg-surface-secondary/40 flex items-center gap-2">
                          <Search className="size-3.5 text-ink-muted shrink-0" />
                          <input
                            type="search"
                            id="modal-platform-search-input"
                            name="modal_platform_search_query"
                            autoComplete="off"
                            autoCorrect="off"
                            spellCheck={false}
                            data-lpignore="true"
                            data-1p-ignore="true"
                            data-bwignore="true"
                            data-form-type="other"
                            data-testid="platform-search"
                            value={modalPlatformSearch}
                            onChange={(e) => setModalPlatformSearch(e.target.value)}
                            placeholder="Search 74 platforms (e.g. 'groq', 'nvidia', 'free')..."
                            className="w-full text-xs bg-transparent border-none outline-none text-ink placeholder:text-ink-muted"
                            autoFocus
                          />
                          {modalPlatformSearch && (
                            <button
                              type="button"
                              onClick={() => setModalPlatformSearch('')}
                              className="p-0.5 text-ink-muted hover:text-ink"
                            >
                              <X className="size-3" />
                            </button>
                          )}
                        </div>

                        {/* Filter Tabs & Hide Added Checkbox */}
                        <div className="px-3 py-1.5 border-b border-border/40 bg-surface-secondary/20 flex items-center justify-between text-[11px]">
                          <div className="flex items-center gap-1.5">
                            <button
                              type="button"
                              onClick={() => setModalCategoryFilter('all')}
                              className={cn(
                                'px-2 py-0.5 rounded text-[10px] font-semibold',
                                modalCategoryFilter === 'all'
                                  ? 'bg-neutral-900 text-white dark:bg-white dark:text-neutral-900'
                                  : 'text-ink-muted hover:text-ink'
                              )}
                            >
                              All ({providers.length})
                            </button>
                            <button
                              type="button"
                              onClick={() => setModalCategoryFilter('models')}
                              className={cn(
                                'px-2 py-0.5 rounded text-[10px] font-semibold',
                                modalCategoryFilter === 'models'
                                  ? 'bg-neutral-900 text-white dark:bg-white dark:text-neutral-900'
                                  : 'text-ink-muted hover:text-ink'
                              )}
                            >
                              Models ({providers.filter((entry) => !isSearchProvider(entry)).length})
                            </button>
                            <button
                              type="button"
                              onClick={() => setModalCategoryFilter('search')}
                              className={cn(
                                'px-2 py-0.5 rounded text-[10px] font-semibold',
                                modalCategoryFilter === 'search'
                                  ? 'bg-neutral-900 text-white dark:bg-white dark:text-neutral-900'
                                  : 'text-ink-muted hover:text-ink'
                              )}
                            >
                              Web Search ({providers.filter((entry) => isSearchProvider(entry)).length})
                            </button>
                          </div>

                          <label className="flex items-center gap-1 cursor-pointer text-ink-muted hover:text-ink">
                            <input
                              type="checkbox"
                              checked={modalHideAdded}
                              onChange={(e) => setModalHideAdded(e.target.checked)}
                              className="size-3 rounded text-neutral-900"
                            />
                            <span>Hide added</span>
                          </label>
                        </div>

                        {/* Items List */}
                        <div role="listbox" aria-label="Provider platforms" className="max-h-48 overflow-y-auto divide-y divide-border/30">
                          {filteredModalPlatforms.length === 0 ? (
                            <div className="p-4 text-center text-xs text-ink-muted">
                              No platform matches "{modalPlatformSearch}"
                            </div>
                          ) : (
                            filteredModalPlatforms.map((p) => {
                              const isSelected = modalSelectedPlatform?.id === p.id;
                              return (
                                <button
                                  key={p.id}
                                  type="button"
                                  role="option"
                                  aria-selected={isSelected}
                                  data-testid={`platform-option-${p.id}`}
                                  onClick={() => {
                                    setModalSelectedPlatform(p);
                                    setIsComboboxOpen(false);
                                    setModalPlatformSearch('');
                                    setModalError(null);
                                  }}
                                  className={cn(
                                    'w-full text-left p-2.5 px-3 text-xs flex items-center justify-between cursor-pointer transition-colors',
                                    isSelected
                                      ? 'bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 font-bold'
                                      : 'hover:bg-surface-secondary text-ink'
                                  )}
                                >
                                  <div className="flex items-center gap-2">
                                    <span>{p.label || p.name}</span>
                                    {p.hint && (
                                      <span
                                        className={cn(
                                          'text-[10px] px-1.5 py-0.2 rounded font-medium',
                                          isSelected
                                            ? 'bg-white/20 text-white'
                                            : 'bg-surface-secondary text-ink-muted'
                                        )}
                                      >
                                        {p.hint}
                                      </span>
                                    )}
                                  </div>
                                  <div className="flex items-center gap-1.5">
                                    {p.configuredOnServer && (
                                      <span
                                        className={cn(
                                          'text-[10px] font-semibold flex items-center gap-1',
                                          isSelected ? 'text-emerald-300' : 'text-emerald-600'
                                        )}
                                      >
                                        <span className="size-1.5 rounded-full bg-emerald-500" />
                                        active
                                      </span>
                                    )}
                                    {isSelected && <Check className="size-3.5" />}
                                  </div>
                                </button>
                              );
                            })
                          )}
                        </div>
                      </div>
                    )}
                  </div>
                </div>

                {/* Cloudflare Account ID (if applicable) */}
                {modalSelectedPlatform?.id === 'cloudflare' && (
                  <div className="space-y-1.5">
                    <label className="text-xs font-semibold text-ink">Cloudflare Account ID</label>
                    <Input
                      type="text"
                      value={modalAccountId}
                      onChange={(e) => setModalAccountId(e.target.value)}
                      placeholder="e.g. 9b73648a1... (found in Cloudflare dashboard URL)"
                      className="h-9 text-xs font-mono"
                    />
                  </div>
                )}

                {/* Keyless Notice Banner */}
                {modalSelectedPlatform?.keyless && (
                  <div className="p-3 rounded-lg bg-sky-50 dark:bg-sky-950/40 text-sky-800 dark:text-sky-200 border border-sky-200 dark:border-sky-800 text-xs flex items-center gap-2">
                    <Zap className="size-4 shrink-0 text-sky-600" />
                    <span>
                      <strong>Keyless Gateway:</strong> {modalSelectedPlatform.name} requires no API key. Click <strong>Add key & Activate</strong> to route completions anonymously.
                    </span>
                  </div>
                )}

                {/* API Key Input */}
                <div className="space-y-1.5">
                  <div className="flex items-center justify-between">
                    <label className="text-xs font-semibold text-ink">
                      {modalSelectedPlatform?.id === 'cloudflare' ? 'API Token' : 'API key'}
                    </label>
                    <div className="flex items-center gap-2">
                      {!modalSelectedPlatform?.keyless && (
                        <button
                          type="button"
                          onClick={() => setModalSeveral(!modalSeveral)}
                          className="text-[11px] text-ink-muted hover:underline"
                        >
                          {modalSeveral ? 'Single key' : 'Paste several'}
                        </button>
                      )}
                      {modalSelectedPlatform?.docUrl && (
                        <a
                          href={modalSelectedPlatform.docUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          className="text-[11px] text-brand-600 hover:underline flex items-center gap-0.5"
                        >
                          Get API key â†—
                        </a>
                      )}
                    </div>
                  </div>

                  {modalSeveral ? (
                    <textarea
                      value={modalApiKey}
                      onChange={(e) => setModalApiKey(e.target.value)}
                      rows={3}
                      placeholder="Paste keys (one per line)..."
                      className="w-full text-xs font-mono p-2.5 rounded-lg border border-border bg-surface text-ink"
                    />
                  ) : (
                    <div className="relative">
                      <Input
                        type={modalShowKey ? 'text' : 'password'}
                        id="modal-provider-api-key"
                        name="modal_provider_api_key"
                        autoComplete="new-password"
                        data-lpignore="true"
                        data-1p-ignore="true"
                        data-bwignore="true"
                        data-form-type="other"
                        data-testid="modal-api-key"
                        value={modalApiKey}
                        onChange={(e) => setModalApiKey(e.target.value)}
                        placeholder={
                          modalSelectedPlatform?.keyless
                            ? 'Optional custom token (or leave blank)'
                            : 'Paste API key here...'
                        }
                        className="h-9 text-xs font-mono pr-8"
                      />
                      <button
                        type="button"
                        onClick={() => setModalShowKey(!modalShowKey)}
                        className="absolute right-2.5 top-1/2 -translate-y-1/2 text-ink-muted hover:text-ink text-xs"
                      >
                        {modalShowKey ? <EyeOff className="size-3.5" /> : <Eye className="size-3.5" />}
                      </button>
                    </div>
                  )}
                </div>
              </div>
            )}

            {/* TAB 2: IMPORT FILE */}
            {modalTab === 'import' && (
              <div className="space-y-3">
                <p className="text-xs text-ink-muted">
                  Paste keys in <code>KEY_NAME=value</code> format or raw JSON configuration:
                </p>
                <textarea
                  value={modalImportRaw}
                  onChange={(e) => setModalImportRaw(e.target.value)}
                  rows={5}
                  placeholder="GROQ_API_KEY=gsk_...&#10;GEMINI_API_KEY=AIzaSy...&#10;NVIDIA_API_KEY=nvapi-..."
                  className="w-full text-xs font-mono p-3 rounded-lg border border-border bg-surface text-ink"
                />
              </div>
            )}

            {/* TAB 3: CUSTOM ENDPOINT */}
            {modalTab === 'endpoint' && (
              <div className="space-y-3">
                <div className="space-y-1.5">
                  <label className="text-xs font-semibold text-ink">Custom Gateway Base URL</label>
                  <Input
                    type="text"
                    value={modalCustomEndpoint}
                    onChange={(e) => setModalCustomEndpoint(e.target.value)}
                    placeholder="https://my-openai-gateway.com/v1"
                    className="h-9 text-xs font-mono"
                  />
                </div>

                <div className="space-y-1.5">
                  <label className="text-xs font-semibold text-ink">Custom Model Target</label>
                  <Input
                    type="text"
                    value={modalCustomModel}
                    onChange={(e) => setModalCustomModel(e.target.value)}
                    placeholder="e.g. meta-llama/Llama-3-70b-chat"
                    className="h-9 text-xs font-mono"
                  />
                </div>

                <div className="space-y-1.5">
                  <label className="text-xs font-semibold text-ink">API Key (Optional)</label>
                  <Input
                    type="password"
                    id="modal-custom-endpoint-key"
                    name="modal_custom_endpoint_key"
                    autoComplete="new-password"
                    data-lpignore="true"
                    data-1p-ignore="true"
                    data-bwignore="true"
                    data-form-type="other"
                    value={modalApiKey}
                    onChange={(e) => setModalApiKey(e.target.value)}
                    placeholder="Leave blank for local/open endpoints"
                    className="h-9 text-xs font-mono"
                  />
                </div>
              </div>
            )}

            {/* Error Notice */}
            {modalError && (
              <div
                data-testid="modal-error-banner"
                className="p-2.5 rounded-lg bg-rose-50 dark:bg-rose-950/40 text-rose-800 dark:text-rose-200 border border-rose-200 dark:border-rose-800 text-xs flex items-center justify-between gap-2"
              >
                <div className="flex items-center gap-2 min-w-0">
                  <AlertCircle className="size-4 shrink-0 text-rose-600" />
                  <span className="truncate">{modalError}</span>
                </div>
                {(modalError.includes('changed') ||
                  modalError.includes('409') ||
                  modalError.includes('conflict') ||
                  modalError.includes('Refresh')) && (
                  <button
                    type="button"
                    onClick={async () => {
                      setModalError(null);
                      loadSettings();
                    }}
                    className="px-2 py-0.5 rounded text-[11px] font-bold bg-rose-600 text-white hover:bg-rose-700 shrink-0 transition-colors flex items-center gap-1"
                  >
                    <RefreshCw className="size-3" />
                    Sync & Retry
                  </button>
                )}
              </div>
            )}

            {/* Modal Actions */}
            <div className="flex items-center justify-end gap-2 pt-2 border-t border-border/50">
              <Button
                variant="outline"
                size="sm"
                onClick={() => {
                  setIsAddKeyOpen(false);
                  setIsComboboxOpen(false);
                }}
                className="h-8 text-xs font-semibold"
              >
                Cancel
              </Button>

              {modalTab === 'import' ? (
                <Button
                  variant="primary"
                  size="sm"
                  onClick={handleImportRawKeys}
                  loading={modalTesting}
                  className="h-8 text-xs font-bold bg-neutral-900 text-white dark:bg-white dark:text-neutral-900"
                >
                  Import Keys
                </Button>
              ) : (
                <Button
                  variant="primary"
                  size="sm"
                  data-testid="modal-add-key"
                  onClick={handleModalAddKey}
                  loading={modalTesting}
                  disabled={
                    modalTab === 'key' &&
                    (!modalSelectedPlatform ||
                      (!modalSelectedPlatform.keyless && !modalApiKey.trim()))
                  }
                  className="h-8 text-xs font-bold bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 hover:bg-neutral-800"
                >
                  Add key & Activate
                </Button>
              )}
            </div>
          </div>
        </div>
      )}

      {/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */}
      {/* â”€â”€â”€ COOLDOWN FLUSH MODAL â”€â”€â”€ */}
      {/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */}
      {isCooldownFlushOpen && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs animate-[fade-in_150ms_ease-out]">
          <div
            ref={focusTrapRef}
            role="dialog"
            aria-modal="true"
            aria-labelledby="cooldown-flush-dialog-title"
            data-testid="cooldown-flush-dialog"
            className="relative flex max-h-[90dvh] w-full max-w-md flex-col rounded-2xl bg-surface border border-border shadow-2xl p-6 space-y-4 overflow-y-auto"
          >
            {/* Header */}
            <div className="flex items-center justify-between border-b border-border/50 pb-3">
              <h2 id="cooldown-flush-dialog-title" className="text-lg font-bold text-ink flex items-center gap-2">
                <RotateCcw className="size-4 text-amber-500" />
                Flush Provider Cooldown
              </h2>
              <button
                type="button"
                data-testid="modal-close"
                aria-label="Close cooldown flush dialog"
                onClick={() => {
                  setIsCooldownFlushOpen(false);
                  setCooldownFlushProvider(null);
                  setCooldownFlushAll(false);
                }}
                className="p-1 rounded-md text-ink-muted hover:text-ink transition-colors"
              >
                <X className="size-4" />
              </button>
            </div>

            {/* Content */}
            <div className="space-y-3.5">
              {cooldownFlushAll ? (
                <div className="space-y-2 text-center">
                  <div className="p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center gap-2">
                    <AlertCircle className="size-5 text-amber-500 shrink-0" />
                  </div>
                  <p className="text-xs text-ink">
                    This will immediately clear all active cooldown timers for <strong>{Object.keys(cooldowns).length}</strong> rate-limited providers.
                  </p>
                  <p className="text-xs text-ink-muted">
                    Providers will be eligible for routing again immediately. Use this if you believe the upstream rate limits have reset.
                  </p>
                  <div className="rounded-lg border border-border/60 bg-surface-secondary/50 p-3 text-left max-h-40 overflow-y-auto">
                    {Object.entries(cooldowns).map(([prov, info]) => (
                      <div key={prov} className="flex items-center justify-between text-[11px] py-1">
                        <span className="font-semibold text-ink uppercase tracking-wider">{prov}</span>
                        <span className="font-mono text-amber-700 dark:text-amber-300">
                          {info.remainingSeconds}s remaining
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
              ) : cooldownFlushProvider ? (
                <div className="space-y-2 text-center">
                  {(() => {
                    const provider = providers.find(p => p.id === cooldownFlushProvider);
                    const info = cooldowns[cooldownFlushProvider];
                    return (
                      <>
                        <div className="p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center gap-2">
                          <AlertCircle className="size-5 text-amber-500 shrink-0" />
                        </div>
                        <p className="text-xs text-ink">
                          This will immediately clear the cooldown timer for <strong>{provider?.name || cooldownFlushProvider}</strong>.
                        </p>
                        <p className="text-xs text-ink-muted">
                          The provider will be eligible for routing again immediately.
                        </p>
                        <div className="rounded-lg border border-border/60 bg-surface-secondary/50 p-3 text-left">
                          <div className="flex items-center justify-between text-[11px] py-1">
                            <span className="font-semibold text-ink uppercase tracking-wider">{provider?.name || cooldownFlushProvider}</span>
                            <span className="font-mono text-amber-700 dark:text-amber-300">
                              {info?.remainingSeconds}s remaining
                            </span>
                          </div>
                          <div className="text-[10px] text-ink-muted">{info?.reason || 'Rate limit backoff (429)'}</div>
                        </div>
                      </>
                    );
                  })()}
                </div>
              ) : (
                <div className="p-4 rounded-lg border border-dashed border-border/60 bg-surface-secondary/30 text-center">
                  <RotateCcw className="size-10 text-amber-500 mx-auto mb-2 opacity-50" />
                  <p className="text-xs text-ink-muted">Select a provider or click "Flush All" to clear cooldowns.</p>
                </div>
              )}
            </div>

            {/* Modal Actions */}
            <div className="flex items-center justify-end gap-2 pt-2 border-t border-border/50">
              <Button
                variant="outline"
                size="sm"
                onClick={() => {
                  setIsCooldownFlushOpen(false);
                  setCooldownFlushProvider(null);
                  setCooldownFlushAll(false);
                }}
                className="h-8 text-xs font-semibold"
              >
                Cancel
              </Button>

              {cooldownFlushAll ? (
                <Button
                  variant="primary"
                  size="sm"
                  onClick={() => {
                    setCooldowns({});
                    setIsCooldownFlushOpen(false);
                    setCooldownFlushAll(false);
                  }}
                  className="h-8 text-xs font-bold bg-neutral-900 text-white dark:bg-white dark:text-neutral-900"
                >
                  Flush All Cooldowns
                </Button>
              ) : cooldownFlushProvider ? (
                <Button
                  variant="primary"
                  size="sm"
                  onClick={() => {
                    const nextCooldowns = { ...cooldowns };
                    delete nextCooldowns[cooldownFlushProvider!];
                    setCooldowns(nextCooldowns);
                    setIsCooldownFlushOpen(false);
                    setCooldownFlushProvider(null);
                  }}
                  className="h-8 text-xs font-bold bg-neutral-900 text-white dark:bg-white dark:text-neutral-900"
                >
                  Flush This Provider
                </Button>
              ) : null}
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

