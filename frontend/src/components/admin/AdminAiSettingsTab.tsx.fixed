                Active Latency: ~140ms
              </span>
            </div>
            <h2 className="text-xl font-black text-ink tracking-tight flex items-center gap-2 pt-1">
              <Brain className="size-5 text-brand-600" />
              Autonomous Enterprise AI Orchestrator
            </h2>
            <p className="text-xs text-ink-muted max-w-3xl">
              Self-optimizing AI engine that dynamically matches candidate requests with the fastest, smartest available model:
              <strong className="text-ink"> Sub-200ms LPUs (Groq/OVH)</strong> for real-time autocomplete, and
              <strong className="text-ink"> 70B+ Frontier Models (NVIDIA/Gemini/DeepSeek)</strong> for cover letters and interview coaching.
            </p>
          </div>

          {/* Quick Autonomous Strategy Mode Switcher */}
          <div className="flex flex-wrap items-center gap-1.5 p-1 rounded-xl bg-surface-secondary/80 border border-border/60 shrink-0">
            {[
              { id: 'adaptive', label: 'ðŸš€ Adaptive Autonomous', tip: 'Task-aware routing: Fast for typing, Deep for writing' },
              { id: 'speed', label: 'âš¡ Ultra-Fast (<200ms)', tip: 'Prioritizes Groq & Cerebras LPUs' },
              { id: 'frontier', label: 'ðŸ§  Maximum Frontier (70B+)', tip: 'Forces highest reasoning depth' },
            ].map((strat) => (
              <button
                key={strat.id}
                type="button"
                onClick={() => {
                  if (strat.id === 'speed') setPrimaryProvider('groq');
                  else if (strat.id === 'frontier') setPrimaryProvider('gemini');
                  else setPrimaryProvider('nvidia');
                  setSavedSuccess(true);
                  setTimeout(() => setSavedSuccess(false), 2500);
                }}
                title={strat.tip}
                className={cn(
                  'px-3 py-1.5 rounded-lg text-xs font-bold transition-all whitespace-nowrap',
                  (strat.id === 'speed' && primaryProvider === 'groq') ||
                  (strat.id === 'frontier' && primaryProvider === 'gemini') ||
                  (strat.id === 'adaptive' && primaryProvider !== 'groq' && primaryProvider !== 'gemini')
                    ? 'bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 shadow-xs'
                    : 'text-ink-muted hover:text-ink hover:bg-surface'
                )}
              >
                {strat.label}
              </button>
            ))}
          </div>
        </div>

        {/* Task-Aware Routing Flow Indicators */}
        <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1 border-t border-border/40 text-xs">
          <div className="flex items-start gap-2.5 p-2.5 rounded-xl bg-surface/60 border border-border/40">
            <Zap className="size-4 text-amber-500 mt-0.5 shrink-0" />
            <div>
              <div className="font-bold text-ink">Interactive Micro-Tasks</div>
              <div className="text-[11px] text-ink-muted">Autocomplete, Bullet Polish, ATS Matching</div>
              <div className="text-[10px] font-mono text-emerald-600 dark:text-emerald-400 font-semibold mt-0.5">
                â†³ Groq LPU / Cerebras (~140ms, Temp 0.2)
              </div>
            </div>
          </div>

