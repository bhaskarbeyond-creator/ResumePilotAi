/**
 * FreeLLMAPI Unified AI Multi-Provider Engine & Governance Panel
 *
 * Full 100% reproduction of FreeLLMAPI 0.16.6 UI/UX:
 * - Tab 1 ("Keys"):
 *   - 74 provider catalog with live search, status pills (All/Healthy/Issues/Disabled),
 *     sub-pills (Providers/Quota signals/Unified API key/Anthropic/Agents),
 *     batch health checking, config export, and direct inline key editing.
 *   - Add Key Dialog matching FreeLLMAPI 0.16.6:
 *     - Pane 1: "Provider key" with searchable combobox over all 74 providers (grouped by
 *       Web Search vs Models, with hint badges and "Hide added providers" toggle).
 *     - Pane 2: "Import file" (.env / .json / raw keys).
 *     - Pane 3: "Custom endpoint" (custom OpenAI-compatible gateway + base URL).
 *     - Non-blocking save: saves credential immediately to server, updates state, and runs test.
 * - Tab 2 ("Models & Fallback Chains"):
 *   - Named chains (auto:default, auto:free-claude-code), context chips (Any, 32K+, 128K+, 1M+),
 *     Vision/Tools filters, multi-metric model table with colored progress bars for
 *     Reliability (green), Speed (blue), and Intelligence (purple), guardrails, composite score.
 * - Tab 3 ("Claude Code & Agents"):
 *   - Live wire setup for Claude Code CLI and Anthropic SDK via reverse proxy.
 * - Tab 4 ("Playground"):
 *   - Live prompt tester against any registered provider or fallback chain.
 *
 * INVARIANTS PRESERVED:
 * 1. ZERO PLAINTEXT SECRET LEAKAGE: Masked keys displayed, credentials stored server-side.
 * 2. POST-SAVE MASKING: Input cleared after save, displays "âœ“ Active on server".
 * 3. DYNAMIC MODEL IDS: Supports curated models AND arbitrary custom model IDs.
 */

import React, { useState, useEffect, useMemo, useRef } from 'react';
import { useSearchParams } from 'react-router-dom';
import { Card, CardContent } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { cn } from '@/lib/utils';
import { get, post } from '@/lib/api-client';
import {
  ALL_74_PROVIDERS_CATALOG,
  type ProviderCatalogEntry,
} from './freellmapi-catalog';
import {
  Brain,
  CheckCircle2,
  AlertCircle,
  RefreshCw,
  Key,
  Shield,
  Zap,
  Sliders,
  Check,
  Eye,
  EyeOff,
  Play,
  Sparkles,
  Search,
  Download,
  Plus,
  X,
  ExternalLink,
  ChevronRight,
  ChevronDown,
  ChevronsUpDown,
  Layers,
  Terminal,
  Copy,
  Info,
  Radio,
  Clock,
  Filter,
  CheckCheck,
  Upload,
  FileText,
  RotateCcw,
  Trash2,
  Gauge,
} from 'lucide-react';

/**
 * Provider tiers used by the Keys screen category tabs.
 *
 * FRONTIER â€” paid-adjacent free tiers with flagship intelligence (Llama 3.3 70B,
 *            Gemini 2.0 Flash, Mistral Large, DeepSeek V3, GPT-4o-mini â€¦).
 * MESH     â€” community/aggregator gateways with generous free quotas.
 * SEARCH   â€” agent web-search & extraction tools (never chat candidates).
 */
const FRONTIER_PROVIDER_IDS = new Set<string>([
  'groq', 'cerebras', 'gemini', 'mistral', 'nvidia', 'openrouter', 'deepseek',
  'openai', 'cloudflare', 'cohere', 'siliconflow', 'modelscope', 'huggingface',
]);

function isSearchProvider(provider: Pick<ProviderCatalogEntry, 'group' | 'type'>): boolean {
  return provider.group === 'search' || provider.type === 'search' || provider.type === 'media';
}

type ProviderTier = 'all' | 'frontier' | 'mesh' | 'search';

export interface ProviderItem extends ProviderCatalogEntry {}

export interface FallbackChain {
  id: string;
  name: string;
  alias: string;
  isDefault?: boolean;
  isCurated?: boolean;
  isActive: boolean;
  modelsCount: number;
}

export interface CuratedModel {
  id: string;
  name: string;
  providerCount: number;
  providersText: string;
  rpm: string;
  contextWindow: string;
  supportsVision: boolean;
  supportsTools: boolean;
  reliabilityScore: number;
  speedScore: number;
  intelligenceScore: number;
  guardrails: string;
  compositeScore: number;
  scoreSubtitle?: string;
  enabled: boolean;
}

export function AdminAiSettingsTab() {
  const [searchParams, setSearchParams] = useSearchParams();

  // Parse all URL params for deep linking
  const subtabParam = (searchParams.get('subtab') || window.location.hash.replace('#', '') || '').toLowerCase();
  const providerParam = (searchParams.get('provider') || '').toLowerCase().trim();
  const categoryParam = (searchParams.get('category') || '').toLowerCase().trim();

  const initialTab = (['keys', 'models', 'claude', 'playground'].includes(subtabParam)
    ? subtabParam
    : 'keys') as 'keys' | 'models' | 'claude' | 'playground';

  // 5 Subtabs for Keys tab with deep link support
  type SubTab = 'providers' | 'key-pool' | 'metrics' | 'unified-gateway' | 'discovery';
  const [activeSubTab, setActiveSubTab] = useState<SubTab>(
    (['providers', 'key-pool', 'metrics', 'unified-gateway', 'discovery'].includes(subtabParam)
      ? subtabParam
      : 'providers') as SubTab
  );

  // Navigation tabs with deep link synchronisation
  const [activeTab, setActiveTab] = useState<'keys' | 'models' | 'claude' | 'playground'>(initialTab);

  // Synchronize activeTab on URL query param changes
  useEffect(() => {
    const currentSubtab = (searchParams.get('subtab') || window.location.hash.replace('#', '') || '').toLowerCase();
    if (['keys', 'models', 'claude', 'playground'].includes(currentSubtab)) {
      setActiveTab(currentSubtab as 'keys' | 'models' | 'claude' | 'playground');
    }
    // Also sync subtabs
    if (['providers', 'key-pool', 'metrics', 'unified-gateway', 'discovery'].includes(currentSubtab)) {
      setActiveSubTab(currentSubtab as SubTab);
    }
  }, [searchParams]);

  // Synchronize activeTab on window hashchange events
  useEffect(() => {
    const handleHashChange = () => {
      const hash = window.location.hash.replace('#', '').toLowerCase();
      if (['keys', 'models', 'claude', 'playground'].includes(hash)) {
        setActiveTab(hash as 'keys' | 'models' | 'claude' | 'playground');
      }
      if (['providers', 'key-pool', 'metrics', 'unified-gateway', 'discovery'].includes(hash)) {
        setActiveSubTab(hash as SubTab);
      }
    };
    window.addEventListener('hashchange', handleHashChange);
    return () => window.removeEventListener('hashchange', handleHashChange);
  }, []);

  const handleSelectTab = (tab: 'keys' | 'models' | 'claude' | 'playground') => {
    setActiveTab(tab);
    const nextParams = new URLSearchParams(searchParams);
    nextParams.set('subtab', tab);
    setSearchParams(nextParams, { replace: true });
  };

  const handleSelectSubTab = (subTab: SubTab) => {
    setActiveSubTab(subTab);
    const nextParams = new URLSearchParams(searchParams);
    nextParams.set('subtab', subTab);
    // Clear provider/category filters when switching subtabs
    nextParams.delete('provider');
    nextParams.delete('category');
    setSearchParams(nextParams, { replace: true });
  };

  // Handle deep link to specific provider
  useEffect(() => {
    if (providerParam && activeTab === 'keys') {
      const provider = providers.find(p => p.id === providerParam);
      if (provider) {
        setExpandedProvider(provider.id);
        if (subPill !== 'providers') setSubPill('providers');
      }
    }
  }, [providerParam, activeTab, providers, subPill]);

  // Handle deep link to category filter
  useEffect(() => {
    if (categoryParam && activeTab === 'keys') {
      if (categoryParam === 'frontier' || categoryParam === 'fast') {
        setTierFilter('frontier');
      } else if (categoryParam === 'mesh' || categoryParam === 'community') {
        setTierFilter('mesh');
      } else if (categoryParam === 'search') {
        setTierFilter('search');
      }
    }
  }, [categoryParam, activeTab]);

  // Operation notices (Cuba M3 Toast banner â€” replaces native alert dialogs)
  const [inlineNotice, setInlineNotice] = useState<{ type: 'success' | 'error' | 'info'; text: string } | null>(null);
  const noticeTimerRef = useRef<ReturnType<typeof setTimeout> | null>(null);
  const showNotice = (type: 'success' | 'error' | 'info', text: string) => {
    if (noticeTimerRef.current) clearTimeout(noticeTimerRef.current);
    setInlineNotice({ type, text });
    noticeTimerRef.current = setTimeout(() => setInlineNotice(null), 5000);
  };

  // Keys tab state â€” ALWAYS PRE-POPULATED with all 74 providers
  const [providers, setProviders] = useState<ProviderItem[]>(ALL_74_PROVIDERS_CATALOG);
  const [subPill, setSubPill] = useState<'providers' | 'quota' | 'unified' | 'anthropic' | 'agents'>('providers');
  const [statusFilter, setStatusFilter] = useState<'all' | 'healthy' | 'issues' | 'disabled'>('all');
  const [tierFilter, setTierFilter] = useState<ProviderTier>('all');
  const [searchQuery, setSearchQuery] = useState('');
  const [expandedProvider, setExpandedProvider] = useState<string | null>(null);
  const [cooldowns, setCooldowns] = useState<Record<string, { remainingSeconds: number; reason: string }>>({});
  const [keyPoolDrafts, setKeyPoolDrafts] = useState<Record<string, string>>({});
  const modalRef = useRef<HTMLDivElement>(null);

  // Global settings
  const [primaryProvider, setPrimaryProvider] = useState('nvidia');
  const [enableFallback, setEnableFallback] = useState(true);
  const [temperature, setTemperature] = useState(0.7);
  const [maxTokens, setMaxTokens] = useState(2048);
  const [revision, setRevision] = useState(0);

  // Unified resilient save helper: handles optimistic concurrency auto-resolution
  const executeAiSave = async (payload: Record<string, any>): Promise<number> => {
    const payloadWithRev = {
      ...payload,
      expectedRevision: revision !== undefined && revision !== 0 ? revision : undefined,
    };
    try {
      const res = await post<{ revision?: number }>('/admin/ai-settings', payloadWithRev);
      const newRev = Number(res?.revision) || (revision ? revision + 1 : 1);
      setRevision(newRev);
      return newRev;
    } catch (err: any) {
      if (err.response?.status === 409 || err.response?.data?.code === 'AI_SETTINGS_CONFLICT') {
        const freshRev = err.response?.data?.currentRevision;
        if (freshRev !== undefined) {
          setRevision(freshRev);
          // Idempotent retry with authoritative server revision
          const retryRes = await post<{ revision?: number }>('/admin/ai-settings', {
            ...payload,
            expectedRevision: freshRev,
          });
          const resolvedRev = Number(retryRes?.revision) || freshRev + 1;
          setRevision(resolvedRev);
          return resolvedRev;
        }
        const fresh = await get<{ revision?: number }>('/admin/ai-settings');
        if (fresh?.revision !== undefined) {
          setRevision(fresh.revision);
          const retryRes = await post<{ revision?: number }>('/admin/ai-settings', {
            ...payload,
            expectedRevision: fresh.revision,
          });
          const resolvedRev = Number(retryRes?.revision) || fresh.revision + 1;
          setRevision(resolvedRev);
          return resolvedRev;
        }
      }
      throw err;
    }
  };

  // Fallback chains & models state
  const [chains, setChains] = useState<FallbackChain[]>([
    { id: 'default', name: 'Default', alias: 'auto:default', isDefault: true, isActive: true, modelsCount: 22 },
    { id: 'free-claude-code', name: 'free-claude-code', alias: 'auto:free-claude-code', isCurated: true, isActive: true, modelsCount: 22 },
  ]);
  const [activeChainId, setActiveChainId] = useState('auto:free-claude-code');
  const [curatedModels, setCuratedModels] = useState<CuratedModel[]>([]);
  const [modelSearch, setModelSearch] = useState('');
  const [filterVision, setFilterVision] = useState(false);
  const [filterTools, setFilterTools] = useState(false);
  const [contextFilter, setContextFilter] = useState<'any' | '32k' | '128k' | '1m'>('any');

  // Secret management & testing
  const [secretInputs, setSecretInputs] = useState<Record<string, string>>({});
  const [showSecretField, setShowSecretField] = useState<Record<string, boolean>>({});
  const [testingId, setTestingId] = useState<string | null>(null);
  const [testStatus, setTestStatus] = useState<Record<string, { ok: boolean; message: string; latencyMs?: number }>>({});
  const [lastTestNotice, setLastTestNotice] = useState<{ id: string; name: string; ok: boolean; message: string; latencyMs?: number } | null>(null);
  const [checkingAll, setCheckingAll] = useState(false);

  // Add Key Modal state
  const [isAddKeyOpen, setIsAddKeyOpen] = useState(false);
  const [isComboboxOpen, setIsComboboxOpen] = useState(false);
  const [modalPlatformSearch, setModalPlatformSearch] = useState('');
  const [modalCategoryFilter, setModalCategoryFilter] = useState<'all' | 'models' | 'search'>('all');
  const [modalSelectedPlatform, setModalSelectedPlatform] = useState<ProviderItem | null>(null);
  const [modalHideAdded, setModalHideAdded] = useState(false);
  const [modalApiKey, setModalApiKey] = useState('');
  const [modalAccountId, setModalAccountId] = useState('');
  const [modalSeveral, setModalSeveral] = useState(false);
  const [modalTab, setModalTab] = useState<'key' | 'import' | 'endpoint'>('key');
  const [modalCustomEndpoint, setModalCustomEndpoint] = useState('');
  const [modalCustomModel, setModalCustomModel] = useState('');
  const [modalImportRaw, setModalImportRaw] = useState('');
  const [modalTesting, setModalTesting] = useState(false);
  const [modalError, setModalError] = useState<string | null>(null);
  const [modalShowKey, setModalShowKey] = useState(false);

  // Operations state
  const [loading, setLoading] = useState(false);
  const [saving, setSaving] = useState(false);
  const [savedSuccess, setSavedSuccess] = useState(false);
  const [copiedText, setCopiedText] = useState<string | null>(null);

  // Dynamic Model Discovery state
  const [discoveredModels, setDiscoveredModels] = useState<
    Record<
      string,
      Array<{
        id: string;
        name: string;
        tier?: string;
        contextWindow?: string;
        supportsVision?: boolean;
        pricing?: any;
      }>
    >
  >({});
  const [discoveringProviderId, setDiscoveringProviderId] = useState<string | null>(null);
  const [modelDrafts, setModelDrafts] = useState<Record<string, string>>({});
  const [modelInputMode, setModelInputMode] = useState<Record<string, 'dropdown' | 'custom'>>({});
  const [savingModelId, setSavingModelId] = useState<string | null>(null);
  const [modelSavedNotice, setModelSavedNotice] = useState<Record<string, boolean>>({});

  // Fallback Chains discovery & save state
  const [discoveringAllModels, setDiscoveringAllModels] = useState(false);
  const [savingChain, setSavingChain] = useState(false);
  const [chainSavedSuccess, setChainSavedSuccess] = useState(false);

  // Playground state
  const [playgroundPrompt, setPlaygroundPrompt] = useState('Explain the difference between a process and a thread in 2 sentences.');
  const [playgroundModel, setPlaygroundModel] = useState('auto:free-claude-code');
  const [playgroundOutput, setPlaygroundOutput] = useState('');
  const [playgroundLoading, setPlaygroundLoading] = useState(false);
  const [playgroundLatency, setPlaygroundLatency] = useState<number | null>(null);
  const [playgroundTemperature, setPlaygroundTemperature] = useState(0.7);
  const [playgroundMaxTokens, setPlaygroundMaxTokens] = useState(500);
  const [playgroundActiveMeta, setPlaygroundActiveMeta] = useState<{ provider?: string; model?: string; latency?: number } | null>(null);

  // Cooldown Flush Modal state
  const [isCooldownFlushOpen, setIsCooldownFlushOpen] = useState(false);
  const [cooldownFlushProvider, setCooldownFlushProvider] = useState<string | null>(null);
  const [cooldownFlushAll, setCooldownFlushAll] = useState(false);

  // Focus trap for modals (WCAG 2.1 AA compliance)
  const focusTrapRef = useRef<HTMLDivElement>(null);
  const previousFocusRef = useRef<HTMLElement | null>(null);

  // Combobox click-outside ref
  const comboboxRef = useRef<HTMLDivElement>(null);
  useEffect(() => {
    function handleClickOutside(e: MouseEvent) {
      if (comboboxRef.current && !comboboxRef.current.contains(e.target as Node)) {
        setIsComboboxOpen(false);
      }
    }
    document.addEventListener('mousedown', handleClickOutside);
    return () => document.removeEventListener('mousedown', handleClickOutside);
  }, []);

  // Modal accessibility: focus trap + Escape dismiss + initial focus.
  // Required by WCAG 2.1 AA (2.1.2 No Keyboard Trap) because the dialog is a
  // full-screen overlay: without this, Tab can reach the page behind it.
  useEffect(() => {
    if (!isAddKeyOpen) return;
    const node = modalRef.current;
    const focusables = () => Array.from(
      node?.querySelectorAll<HTMLElement>(
        'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
      ) || []
    );
    const initial = focusables()[0];
    initial?.focus();

    function onKeyDown(event: KeyboardEvent) {
      if (event.key === 'Escape') {
        event.preventDefault();
        setIsAddKeyOpen(false);
        setIsComboboxOpen(false);
        return;
      }
      if (event.key !== 'Tab') return;
      const list = focusables();
      if (list.length === 0) return;
      const firstEl = list[0];
      const lastEl = list[list.length - 1];
      if (event.shiftKey && document.activeElement === firstEl) {
        event.preventDefault();
        lastEl.focus();
      } else if (!event.shiftKey && document.activeElement === lastEl) {
        event.preventDefault();
        firstEl.focus();
      }
    }

    document.addEventListener('keydown', onKeyDown);
    return () => document.removeEventListener('keydown', onKeyDown);
  }, [isAddKeyOpen]);

  // Cooldown Flush Modal focus trap + Escape dismiss
  useEffect(() => {
    if (!isCooldownFlushOpen) return;
    const node = document.querySelector('[data-testid="cooldown-flush-dialog"]') as HTMLElement;
    const focusables = () => Array.from(
      node?.querySelectorAll<HTMLElement>(
        'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
      ) || []
    );
    const initial = focusables()[0];
    initial?.focus();

    function onKeyDown(event: KeyboardEvent) {
      if (event.key === 'Escape') {
        event.preventDefault();
        setIsCooldownFlushOpen(false);
        setCooldownFlushProvider(null);
        setCooldownFlushAll(false);
        return;
      }
      if (event.key !== 'Tab') return;
      const list = focusables();
      if (list.length === 0) return;
      const firstEl = list[0];
      const lastEl = list[list.length - 1];
      if (event.shiftKey && document.activeElement === firstEl) {
        event.preventDefault();
        lastEl.focus();
      } else if (!event.shiftKey && document.activeElement === lastEl) {
        event.preventDefault();
        firstEl.focus();
      }
    }

    document.addEventListener('keydown', onKeyDown);
    return () => document.removeEventListener('keydown', onKeyDown);
  }, [isCooldownFlushOpen]);

  // Load configuration on mount
  useEffect(() => {
    loadSettings();
  }, []);

  const loadSettings = () => {
    setLoading(true);
    get<{
      settings?: Record<string, any>;
      revision?: number;
      catalog?: ProviderItem[];
      fallbackChains?: FallbackChain[];
      curatedModels?: CuratedModel[];
      configuredProviders?: Record<string, boolean>;
      maskedKeys?: Record<string, string>;
      cooldowns?: Record<string, { remainingSeconds: number; reason: string }>;
    }>('/admin/ai-settings')
      .then((res) => {
        if (res.revision) setRevision(res.revision);
        setCooldowns(res.cooldowns || {});
        if (res.fallbackChains && Array.isArray(res.fallbackChains)) {
          setChains(res.fallbackChains);
        }
        if (res.curatedModels && Array.isArray(res.curatedModels)) {
          setCuratedModels(res.curatedModels);
        }
        if (res.settings) {
          const cfg = res.settings;
          setPrimaryProvider(cfg.provider || 'nvidia');
          setEnableFallback(cfg.enableFallback !== false);
          if (cfg.temperature !== undefined) setTemperature(Number(cfg.temperature));
          if (cfg.maxTokens !== undefined) setMaxTokens(Number(cfg.maxTokens));
        }

        // Merge server configured status with the baseline 74 catalog
        const serverCatalogMap = new Map((res.catalog || []).map((p) => [p.id, p]));
        const configuredMap = res.configuredProviders || {};
        const maskedMap = res.maskedKeys || {};

        setProviders((prev) =>
          prev.map((p) => {
            const serverItem = serverCatalogMap.get(p.id);
            const isConfigured = Boolean(
              p.keyless ||
              serverItem?.configuredOnServer ||
              configuredMap[p.id] ||
              maskedMap[p.id]
            );
            const isCoolingDown = Boolean(res.cooldowns?.[p.id]);
            return {
              ...p,
              configuredOnServer: isConfigured,
              hasKey: Boolean(serverItem?.hasKey || configuredMap[p.id] || maskedMap[p.id]),
              keysCount: p.keyless ? 1 : (serverItem?.keysCount || (isConfigured ? 1 : 0)),
              // 'issues' is the existing three-state union; the precise
              // "âŠ˜ Rate-Limited Cooldown" label comes from `cooldowns`.
              status: isCoolingDown ? 'issues' : (isConfigured ? 'healthy' : 'disabled'),
              latencyMs: serverItem?.latencyMs || p.latencyMs,
              defaultModel: serverItem?.defaultModel || p.defaultModel,
            };
          })
        );
      })
      .catch((err) => {
        console.warn('AI Admin settings fetch notice (catalog preserved):', err.message);
      })
      .finally(() => setLoading(false));
  };

  // Filtered providers for Keys Screen
  const filteredProviders = useMemo(() => {
    return providers.filter((p) => {
      // Sub-pill filter
      if (subPill === 'providers' && p.group !== 'models' && p.group !== 'search') return false;

      // Provider tier filter (Frontier / Community Mesh / Agent Search)
      if (tierFilter === 'frontier' && !FRONTIER_PROVIDER_IDS.has(p.id)) return false;
      if (tierFilter === 'mesh' && (isSearchProvider(p) || FRONTIER_PROVIDER_IDS.has(p.id))) return false;
      if (tierFilter === 'search' && !isSearchProvider(p)) return false;

      // Status filter
      if (statusFilter === 'healthy' && p.status !== 'healthy') return false;
      if (statusFilter === 'issues' && p.status !== 'issues') return false;
      if (statusFilter === 'disabled' && p.status !== 'disabled') return false;

      // Text search
      if (searchQuery.trim()) {
        const q = searchQuery.toLowerCase().trim();
        return (
          p.name.toLowerCase().includes(q) ||
          p.label.toLowerCase().includes(q) ||
          p.id.toLowerCase().includes(q) ||
          (p.defaultModel && p.defaultModel.toLowerCase().includes(q))
        );
      }
      return true;
    });
  }, [providers, statusFilter, searchQuery, subPill, tierFilter]);

  // Providers list for Add Key Modal Combobox
  const filteredModalPlatforms = useMemo(() => {
    return providers.filter((p) => {
      // Category filter
      if (modalCategoryFilter === 'models' && p.group !== 'models') return false;
      if (modalCategoryFilter === 'search' && p.group !== 'search') return false;

      // Hide added filter
      if (modalHideAdded && (p.configuredOnServer || p.hasKey)) return false;

      // Search query
      if (modalPlatformSearch.trim()) {
        const q = modalPlatformSearch.toLowerCase().trim();
        return (
          p.name.toLowerCase().includes(q) ||
          p.label.toLowerCase().includes(q) ||
          p.id.toLowerCase().includes(q) ||
          (p.hint && p.hint.toLowerCase().includes(q))
        );
      }
      return true;
    });
  }, [providers, modalCategoryFilter, modalHideAdded, modalPlatformSearch]);

  // Statistics
  const configuredCount = useMemo(() => {
    return providers.filter((p) => p.configuredOnServer || p.keyless).length;
  }, [providers]);

  const healthyCount = useMemo(() => {
    return providers.filter((p) => (p.configuredOnServer || p.keyless) && p.status !== 'issues').length;
  }, [providers]);

  const totalKeysCount = useMemo(() => {
    return providers.reduce((acc, p) => acc + (p.hasKey ? 1 : p.keyless ? 1 : 0), 0);
  }, [providers]);

  const tierCounts = useMemo(() => {
    const frontier = providers.filter((p) => FRONTIER_PROVIDER_IDS.has(p.id)).length;
    const search = providers.filter((p) => isSearchProvider(p)).length;
    const mesh = providers.length - frontier - search;
    return { all: providers.length, frontier, mesh, search };
  }, [providers]);

  const splitKeyPool = (value: string): string[] => {
    const seen = new Set<string>();
    return String(value || '')
      .split(/[\n,]+/)
      .map((key) => key.trim())
      .filter((key) => {
        if (!key || seen.has(key)) return false;
        seen.add(key);
        return true;
      });
  };

  /**
   * The four operational states mandated by the FreeLLMAPI parity audit.
   * Exact strings are part of the UI contract (Playwright asserts them).
   */
  const providerStatePill = (p: ProviderItem) => {
    const cooling = cooldowns[p.id];
    if (cooling) {
      return {
        label: 'âŠ˜ Rate-Limited Cooldown',
        tone: 'bg-amber-50 text-amber-800 border-amber-200 dark:bg-amber-950/40 dark:text-amber-200 dark:border-amber-800',
        detail: `${cooling.remainingSeconds}s Â· ${cooling.reason}`,
        state: 'cooldown',
      };
    }
    if (p.keyless) {
      return {
        label: 'â—‹ Keyless Active',
        tone: 'bg-sky-50 text-sky-800 border-sky-200 dark:bg-sky-950/40 dark:text-sky-200 dark:border-sky-800',
        detail: 'no credential required',
        state: 'keyless',
      };
    }
    if (p.configuredOnServer || p.hasKey) {
      return {
        label: 'â— Live & Active',
        tone: 'bg-emerald-50 text-emerald-800 border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-200 dark:border-emerald-800',
        detail: `${p.keysCount || 1} ${(p.keysCount || 1) === 1 ? 'key' : 'keys'} Â· ${p.latencyMs}ms`,
        state: 'healthy',
      };
    }
    return {
      label: 'â€” Not Configured',
      tone: 'bg-surface-secondary text-ink-muted border-border',
      detail: 'add a key to activate',
      state: 'disabled',
    };
  };

  // Test Provider Reachability
  const handleTestProvider = async (providerId: string, customKey?: string, customModel?: string) => {
    setTestingId(providerId);
    setTestStatus((prev) => ({ ...prev, [providerId]: undefined as any }));
    try {
      const p = providers.find((item) => item.id === providerId);
      const targetModel = customModel || modelDrafts[providerId] || p?.defaultModel;
      // Resolves to /api/admin/ai/test-provider through the shared axios baseURL.
      const res = await post<{ success?: boolean; latencyMs?: number; message?: string }>(
        '/admin/ai/test-provider',
        {
          provider: providerId,
          model: targetModel,
          apiKey: customKey || secretInputs[providerId] || undefined,
        }
      );

      // Never invent a latency: the badge must reflect a real probe or the
      // server's own message. `latencyMs` stays undefined when unreported.
      const lat = Number(res.latencyMs) > 0 ? Number(res.latencyMs) : undefined;
      const okMsg = res.message || (lat ? `Connected in ${lat}ms` : 'Connection verified');
      setTestStatus((prev) => ({
        ...prev,
        [providerId]: {
          ok: res.success !== false,
          ...(lat ? { latencyMs: lat } : {}),
          message: okMsg,
        },
      }));
      setLastTestNotice({
        id: providerId,
        name: p?.name || providerId,
        ok: res.success !== false,
        message: okMsg,
        latencyMs: lat,
      });

      // Update provider status in local view
      setProviders((prev) =>
        prev.map((item) =>
          item.id === providerId
            ? { ...item, status: 'healthy', ...(lat ? { latencyMs: lat } : {}) }
            : item
        )
      );
    } catch (err: any) {
      const p = providers.find((item) => item.id === providerId);
      const errMsg =
        err.response?.data?.error ||
        err.response?.data?.message ||
        err.message ||
        'Connection test failed';
      setTestStatus((prev) => ({
        ...prev,
        [providerId]: {
          ok: false,
          message: errMsg,
        },
      }));
      setLastTestNotice({
        id: providerId,
        name: p?.name || providerId,
        ok: false,
        message: errMsg,
      });
      setProviders((prev) =>
        prev.map((item) => (item.id === providerId ? { ...item, status: 'issues' } : item))
      );
    } finally {
      setTestingId(null);
    }
  };

  // Dynamic Live Model Discovery for a Single Provider
  const handleDiscoverModels = async (providerId: string) => {
    setDiscoveringProviderId(providerId);
    try {
      const res = await post<{
        success?: boolean;
        count?: number;
        models?: Array<{
          id: string;
          name: string;
          tier?: string;
          contextWindow?: string;
          supportsVision?: boolean;
          pricing?: any;
        }>;
      }>('/admin/ai/fetch-models', { provider: providerId });

      if (res?.models && Array.isArray(res.models) && res.models.length > 0) {
        setDiscoveredModels((prev) => ({ ...prev, [providerId]: res.models! }));
        setModelInputMode((prev) => ({ ...prev, [providerId]: 'dropdown' }));
        const currentModel = providers.find((p) => p.id === providerId)?.defaultModel;
        const exists = res.models.some((m) => m.id === currentModel);
        if (!modelDrafts[providerId]) {
          setModelDrafts((prev) => ({
            ...prev,
            [providerId]: exists && currentModel ? currentModel : res.models![0].id,
          }));
        }
      } else {
        showNotice('info', `No models returned for ${providerId.toUpperCase()}. Verify credentials or endpoint.`);
      }
    } catch (err: any) {
      showNotice('error', `Model discovery failed for ${providerId.toUpperCase()}: ${err.message || 'Unknown error'}`);
    } finally {
      setDiscoveringProviderId(null);
    }
  };

  // Save selected/custom model to MariaDB system_settings
  const handleSaveModel = async (providerId: string) => {
    const modelToSave = (modelDrafts[providerId] || '').trim();
    if (!modelToSave) return;
    setSavingModelId(providerId);
    try {
      const payload: Record<string, any> = {
        provider: providerId,
        model: modelToSave,
        [`${providerId}Model`]: modelToSave,
      };
      await executeAiSave(payload);

      setProviders((prev) =>
        prev.map((p) => (p.id === providerId ? { ...p, defaultModel: modelToSave } : p))
      );
      setModelSavedNotice((prev) => ({ ...prev, [providerId]: true }));
      setTimeout(() => setModelSavedNotice((prev) => ({ ...prev, [providerId]: false })), 3000);
      setSavedSuccess(true);
      setTimeout(() => setSavedSuccess(false), 3000);
      showNotice('success', `Model "${modelToSave}" saved as default for ${providerId.toUpperCase()}.`);
    } catch (err: any) {
      showNotice('error', `Model save failed: ${err.message || 'Unknown error'}`);
    } finally {
      setSavingModelId(null);
    }
  };

  // Discover models across all active & keyless providers
  const handleDiscoverAllModels = async () => {
    setDiscoveringAllModels(true);
    const activeProviders = providers.filter((p) => p.configuredOnServer || p.keyless);
    let totalDiscovered = 0;
    const discoveredCatalog: CuratedModel[] = [...curatedModels];
    const seenModelIds = new Set(curatedModels.map((m) => m.id));

    try {
      for (const prov of activeProviders) {
        try {
          const res = await post<{
            success?: boolean;
            models?: Array<{
              id: string;
              name: string;
              tier?: string;
              contextWindow?: string;
              supportsVision?: boolean;
            }>;
          }>('/admin/ai/fetch-models', { provider: prov.id });

          if (res?.models && Array.isArray(res.models)) {
            setDiscoveredModels((prev) => ({ ...prev, [prov.id]: res.models! }));
            for (const m of res.models) {
              if (!seenModelIds.has(m.id)) {
                seenModelIds.add(m.id);
                totalDiscovered++;
                discoveredCatalog.push({
                  id: m.id,
                  name: m.name || m.id,
                  providerCount: 1,
                  providersText: prov.name,
                  rpm: '60 RPM',
                  contextWindow: m.contextWindow || '128K ctx',
                  supportsVision: Boolean(m.supportsVision),
                  supportsTools: true,
                  reliabilityScore: prov.reliabilityScore || 95,
                  speedScore: prov.speedScore || 90,
                  intelligenceScore: m.tier === 'Frontier' ? 95 : m.tier === 'Standard' ? 85 : 75,
                  guardrails: '-',
                  compositeScore: m.tier === 'Frontier' ? 0.920 : 0.820,
                  enabled: true,
                });
              }
            }
          }
        } catch (_) {
          // Non-fatal per-provider
        }
      }
      setCuratedModels(discoveredCatalog);
      setSavedSuccess(true);
      setTimeout(() => setSavedSuccess(false), 3000);
    } finally {
      setDiscoveringAllModels(false);
    }
  };

  // Save Fallback Chain & Policies
  const handleSaveFallbackChain = async () => {
    setSavingChain(true);
    try {
      const enabledModelIds = curatedModels.filter((m) => m.enabled).map((m) => m.id);
      const payload: Record<string, any> = {
        fallbackChain: {
          alias: activeChainId,
          models: enabledModelIds,
        },
      };
      await executeAiSave(payload);

      setChainSavedSuccess(true);
      setTimeout(() => setChainSavedSuccess(false), 3000);
      showNotice('success', 'Fallback chains and routing policies saved successfully.');
    } catch (err: any) {
      showNotice('error', `Failed to save fallback chain: ${err.message || 'Unknown error'}`);
    } finally {
      setSavingChain(false);
    }
  };

  // Handle Check All (Batch reachability)
  const handleCheckAll = async () => {
    setCheckingAll(true);
    const toCheck = providers.filter((p) => p.configuredOnServer || p.keyless);
    for (const p of toCheck) {
      try {
        await handleTestProvider(p.id);
      } catch {
        // continue batch
      }
    }
    setCheckingAll(false);
  };

  // Direct Save Key for a Single Provider (from expanded row)
  const handleSaveSingleKey = async (providerId: string) => {
    const key = (secretInputs[providerId] || '').trim();
    if (!key) return;
    const pool = splitKeyPool(key);
    if (pool.length === 0) return;
    setSaving(true);
    try {
      const payload: Record<string, any> = {};
      payload[`${providerId}ApiKey`] = pool[0];
      if (pool.length > 1) payload[`${providerId}ApiKeys`] = pool;
      await executeAiSave(payload);

      setProviders((prev) =>
        prev.map((p) =>
          p.id === providerId
            ? { ...p, configuredOnServer: true, hasKey: true, status: 'healthy', keysCount: pool.length }
            : p
        )
      );
      setSecretInputs((prev) => ({ ...prev, [providerId]: '' }));
      setSavedSuccess(true);
      setTimeout(() => setSavedSuccess(false), 3000);
      showNotice('success', `API Key for ${providerId.toUpperCase()} saved securely to MariaDB.`);
      handleTestProvider(providerId, key).catch(() => {});
    } catch (err: any) {
      showNotice('error', `Save failed for ${providerId.toUpperCase()}: ${err.message || 'Unknown error'}`);
    } finally {
      setSaving(false);
    }
  };

  // Save a pooled set of keys for a high-volume provider (Groq/Cerebras/Gemini)
  const handleSaveKeyPool = async (providerId: string) => {
    const pool = splitKeyPool(keyPoolDrafts[providerId] || '');
    if (pool.length === 0) return;
    setSaving(true);
    try {
      const payload: Record<string, any> = {
        [`${providerId}ApiKeys`]: pool,
        [`${providerId}ApiKey`]: pool[0],
      };
      await executeAiSave(payload);
      setProviders((prev) =>
        prev.map((p) =>
          p.id === providerId
            ? { ...p, configuredOnServer: true, hasKey: true, status: 'healthy', keysCount: pool.length }
            : p
        )
      );
      setKeyPoolDrafts((prev) => ({ ...prev, [providerId]: '' }));
      setSavedSuccess(true);
      setTimeout(() => setSavedSuccess(false), 3000);
      showNotice('success', `Key pool (${pool.length} keys) saved for ${providerId.toUpperCase()}.`);
      handleTestProvider(providerId, pool[0]).catch(() => {});
    } catch (err: any) {
      showNotice('error', `Key pool save failed: ${err.message || 'Unknown error'}`);
    } finally {
      setSaving(false);
    }
  };

  // Clear Key for a Single Provider (from expanded row)
  const handleClearSingleKey = async (providerId: string) => {
    if (!window.confirm(`Are you sure you want to clear the stored credential for ${providerId.toUpperCase()}?`)) return;
    setSaving(true);
    try {
      const payload: Record<string, any> = {
        clearSecrets: { [providerId]: true },
      };
      payload[`${providerId}ApiKey`] = '';
      await executeAiSave(payload);

      setProviders((prev) =>
        prev.map((p) =>
          p.id === providerId
            ? { ...p, configuredOnServer: false, hasKey: false, status: 'disabled', keysCount: 0 }
            : p
        )
      );
      setSecretInputs((prev) => ({ ...prev, [providerId]: '' }));
      setSavedSuccess(true);
      setTimeout(() => setSavedSuccess(false), 3000);
      showNotice('info', `Stored credential for ${providerId.toUpperCase()} cleared.`);
    } catch (err: any) {
      showNotice('error', `Clear failed: ${err.message || 'Unknown error'}`);
    } finally {
      setSaving(false);
    }
  };

  // Toggle Provider Activation
  const handleToggleProvider = async (providerId: string, currentEnabled: boolean) => {
    const nextEnabled = !currentEnabled;
    setProviders((prev) =>
      prev.map((p) =>
        p.id === providerId
          ? {
              ...p,
              enabled: nextEnabled,
              status: nextEnabled ? (p.configuredOnServer ? 'healthy' : 'disabled') : 'disabled',
            }
          : p
      )
    );
    try {
      const fieldName = `enable${providerId.charAt(0).toUpperCase() + providerId.slice(1)}`;
      await executeAiSave({
        [fieldName]: nextEnabled,
      });
      showNotice('info', `${providerId.toUpperCase()} ${nextEnabled ? 'enabled' : 'disabled'}.`);
    } catch (err: any) {
      console.warn('Toggle sync notice:', err);
      setProviders((prev) =>
        prev.map((p) => (p.id === providerId ? { ...p, enabled: currentEnabled } : p))
      );
      showNotice('error', `Failed to toggle ${providerId.toUpperCase()}: ${err.message || 'Unknown error'}`);
    }
  };

  // Open Add Key Dialog pre-selected with a specific provider
  const handleOpenAddKeyForProvider = (provider: ProviderItem) => {
    setModalSelectedPlatform(provider);
    setModalPlatformSearch(provider.name);
    setIsAddKeyOpen(true);
    setIsComboboxOpen(false);
    setModalError(null);
  };

  // Add Key Modal Submit (Non-blocking & Robust)
  const handleModalAddKey = async () => {
    if (!modalSelectedPlatform) {
      setModalError('Please select a platform first.');
      return;
    }

    const providerId = modalSelectedPlatform.id;
    const isKeyless = Boolean(modalSelectedPlatform.keyless);
    const key = modalApiKey.trim();

    if (!isKeyless && !key && modalTab === 'key') {
      setModalError('Please enter an API key for this provider.');
      return;
    }

    setModalTesting(true);
    setModalError(null);

    try {
      const payload: Record<string, any> = {};

      const pool = splitKeyPool(key);
      if (providerId === 'cloudflare' && modalAccountId.trim()) {
        payload[`${providerId}ApiKey`] = `${modalAccountId.trim()}:${key}`;
      } else if (pool.length > 1) {
        payload[`${providerId}ApiKeys`] = pool;
        payload[`${providerId}ApiKey`] = pool[0];
      } else {
        payload[`${providerId}ApiKey`] = key || (isKeyless ? 'keyless' : '');
      }

      if (modalCustomEndpoint.trim()) {
        payload[`${providerId}BaseUrl`] = modalCustomEndpoint.trim();
      }

      // Save directly to backend via resilient concurrency-resolving helper
      await executeAiSave(payload);

      // Mark provider configured immediately in UI
      setProviders((prev) =>
        prev.map((p) =>
          p.id === providerId
            ? {
                ...p,
                configuredOnServer: true,
                hasKey: true,
                status: 'healthy',
                keysCount: Math.max(pool.length, (p.keysCount || 0) + (pool.length > 0 ? 0 : 1), 1),
              }
            : p
        )
      );

      // Asynchronously trigger non-blocking probe to verify latency
      handleTestProvider(providerId, key).catch(() => {});

      // Clean up modal
      setIsAddKeyOpen(false);
      setModalApiKey('');
      setModalAccountId('');
      setModalSelectedPlatform(null);
      setSavedSuccess(true);
      setTimeout(() => setSavedSuccess(false), 3000);
      showNotice('success', `Platform ${modalSelectedPlatform.name} configured & activated!`);
    } catch (err: any) {
      const errorMsg =
        err.response?.data?.error?.message ||
        err.response?.data?.error ||
        err.response?.data?.message ||
        err.message ||
        'Failed to save provider key. Please retry.';
      setModalError(typeof errorMsg === 'string' ? errorMsg : JSON.stringify(errorMsg));
    } finally {
      setModalTesting(false);
    }
  };

  // Import raw keys handler
  const handleImportRawKeys = async () => {
    if (!modalImportRaw.trim()) {
      setModalError('Please paste configuration content to import.');
      return;
    }
    setModalTesting(true);
    setModalError(null);
    try {
      const lines = modalImportRaw.split('\n');
      const payload: Record<string, any> = { expectedRevision: revision };
      let detectedCount = 0;

      for (const line of lines) {
        const trimmed = line.trim();
        if (!trimmed || trimmed.startsWith('#')) continue;
        const match = trimmed.match(/^([A-Za-z0-9_]+)[=:]\s*(.+)$/);
        if (match) {
          const varName = match[1].toLowerCase();
          const varVal = match[2].trim().replace(/^['"]|['"]$/g, '');
          const matchedP = providers.find(
            (p) =>
              varName.includes(p.id) ||
              varName.includes(`${p.id}_api_key`) ||
              varName === `${p.id}apikey`
          );
          if (matchedP && varVal) {
            payload[`${matchedP.id}ApiKey`] = varVal;
            detectedCount++;
          }
        }
      }

      if (detectedCount === 0) {
        throw new Error('No matching provider API keys detected in pasted text.');
      }

      const res = await post<{ revision?: number }>('/admin/ai-settings', payload);
      if (res?.revision) setRevision(res.revision);

      setIsAddKeyOpen(false);
      setModalImportRaw('');
      setSavedSuccess(true);
      loadSettings();
      setTimeout(() => setSavedSuccess(false), 3000);
    } catch (err: any) {
      setModalError(err.message || 'Import failed.');
    } finally {
      setModalTesting(false);
    }
  };

  // Handle Save All
  const handleSaveAll = async () => {
    setSaving(true);
    setSavedSuccess(false);
    try {
      const payload: Record<string, any> = {
        provider: primaryProvider,
        enableFallback,
        temperature,
        maxTokens,
      };

      Object.entries(secretInputs).forEach(([pId, keyVal]) => {
        if (keyVal && keyVal.trim()) {
          payload[`${pId}ApiKey`] = keyVal.trim();
        }
      });

      await executeAiSave(payload);

      setSecretInputs({});
      setSavedSuccess(true);
      setTimeout(() => setSavedSuccess(false), 4000);
      showNotice('success', 'All AI settings saved securely to MariaDB.');
      loadSettings();
    } catch (err: any) {
      showNotice('error', `Save failed: ${err.message || 'Unknown error'}`);
    } finally {
      setSaving(false);
    }
  };

  // Export configuration bundle
  const handleExportConfig = () => {
    const exportBundle = {
      version: 'freellmapi-0.16.6-ime365',
      exportedAt: new Date().toISOString(),
      primaryProvider,
      enableFallback,
      temperature,
      maxTokens,
      providers: providers.map((p) => ({
        id: p.id,
        name: p.name,
        type: p.type,
        group: p.group,
        configured: p.configuredOnServer,
        keyless: p.keyless || false,
        model: p.defaultModel,
      })),
      fallbackChains: chains,
    };
    const blob = new Blob([JSON.stringify(exportBundle, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `freellmapi-providers-export-${new Date().toISOString().slice(0, 10)}.json`;
    a.click();
    URL.revokeObjectURL(url);
  };

  // Copy helper
  const handleCopy = (text: string, id: string) => {
    navigator.clipboard.writeText(text);
    setCopiedText(id);
    setTimeout(() => setCopiedText(null), 2000);
  };

  // Filtered models for Screen 2
  const filteredModels = useMemo(() => {
    return curatedModels.filter((m) => {
      if (filterVision && !m.supportsVision) return false;
      if (filterTools && !m.supportsTools) return false;
      if (contextFilter === '32k' && !m.contextWindow.includes('32K') && !m.contextWindow.includes('64K') && !m.contextWindow.includes('128K') && !m.contextWindow.includes('1M') && !m.contextWindow.includes('512K') && !m.contextWindow.includes('262K')) return false;
      if (contextFilter === '128k' && !m.contextWindow.includes('128K') && !m.contextWindow.includes('1M') && !m.contextWindow.includes('512K') && !m.contextWindow.includes('262K')) return false;
      if (contextFilter === '1m' && !m.contextWindow.includes('1M')) return false;

      if (modelSearch.trim()) {
        const q = modelSearch.toLowerCase().trim();
        return (
          m.name.toLowerCase().includes(q) ||
          m.providersText.toLowerCase().includes(q) ||
          m.id.toLowerCase().includes(q)
        );
      }
      return true;
    });
  }, [curatedModels, filterVision, filterTools, contextFilter, modelSearch]);

  const toggleModelInChain = (modelId: string) => {
    setCuratedModels((prev) =>
      prev.map((m) => (m.id === modelId ? { ...m, enabled: !m.enabled } : m))
    );
  };

  const handleEnableAllModels = () => {
    setCuratedModels((prev) => prev.map((m) => ({ ...m, enabled: true })));
  };

  const handleDisableAllModels = () => {
    setCuratedModels((prev) => prev.map((m) => ({ ...m, enabled: false })));
  };

  // Handle Playground Run
  const handleRunPlayground = async () => {
    if (!playgroundPrompt.trim()) return;
    setPlaygroundLoading(true);
    setPlaygroundOutput('');
    setPlaygroundLatency(null);
    setPlaygroundActiveMeta(null);
    const start = Date.now();
    try {
      const res = await post<{
        choices?: Array<{ message?: { content?: string } }>;
        content?: string;
        _freellmapi?: {
          provider?: string;
          actual_model?: string;
          latency_ms?: number;
          fallbacks?: Array<any>;
        };
      }>('/v1/chat/completions', {
        model: playgroundModel,
        messages: [{ role: 'user', content: playgroundPrompt }],
        max_tokens: playgroundMaxTokens,
        temperature: playgroundTemperature,
      }, { timeout: 90000 });

      const elapsed = Date.now() - start;
      setPlaygroundLatency(elapsed);
      if (res._freellmapi) {
        setPlaygroundActiveMeta({
          provider: res._freellmapi.provider,
          model: res._freellmapi.actual_model,
          latency: res._freellmapi.latency_ms || elapsed,
        });
      }
      const text =
        res.choices?.[0]?.message?.content ||
        res.content ||
        JSON.stringify(res, null, 2);
      setPlaygroundOutput(text);
    } catch (err: any) {
      setPlaygroundLatency(Date.now() - start);
      const detail = err.response?.data?.error?.message || err.response?.data?.message || err.message || 'Execution failed';
      setPlaygroundOutput(`[Error]: ${detail}`);
    } finally {
      setPlaygroundLoading(false);
    }
  };

  return (
    <div className="space-y-6">
      {/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */}
      {/* â”€â”€â”€ 10/10 AUTONOMOUS INTELLIGENCE ORCHESTRATION & RADAR BAR â”€â”€â”€ */}
      {/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */}
      <div className="relative overflow-hidden rounded-2xl border border-brand-500/30 bg-gradient-to-r from-brand-950/20 via-surface/80 to-purple-950/20 p-5 backdrop-blur-md shadow-xs space-y-4">
        <div className="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          <div className="space-y-1">
            <div className="flex items-center gap-2 flex-wrap">
              <span className="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 px-3 py-1 text-xs font-bold text-emerald-700 dark:text-emerald-300">
                <span className="size-2 rounded-full bg-emerald-500 animate-pulse" />
                Autonomous Multi-Provider Mesh: Active
              </span>
              <span className="inline-flex items-center gap-1 rounded-full bg-purple-500/15 border border-purple-500/30 px-2.5 py-0.5 text-[11px] font-semibold text-purple-700 dark:text-purple-300 font-mono">
                <Sparkles className="size-3 text-purple-500" />
                Adaptive Intent-Based Auto-Routing
              </span>
              <span className="inline-flex items-center gap-1 rounded-full bg-blue-500/15 border border-blue-500/30 px-2.5 py-0.5 text-[11px] font-semibold text-blue-700 dark:text-blue-300 font-mono">
