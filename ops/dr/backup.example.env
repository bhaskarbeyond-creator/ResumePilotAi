# ─────────────────────────────────────────────────────────────────────────────
# ResumePilot AI — scheduled backup environment  (TEMPLATE)
#
#   cp ops/dr/backup.example.env ops/dr/backup.env
#   chmod 600 ops/dr/backup.env        # the key below is a secret
#   $EDITOR ops/dr/backup.env
#
# ops/dr/backup.env is git-ignored. Only this template is tracked.
# NEVER commit a filled-in copy. NEVER echo these values into a log.
# ─────────────────────────────────────────────────────────────────────────────

# ── Encryption ───────────────────────────────────────────────────────────────
# 32-byte key, base64. Generate with:   openssl rand -base64 32
# REQUIRED when NODE_ENV=production — the pipeline refuses to write an
# unencrypted dump rather than silently producing one.
#
# ⚠️  ESCROW THIS KEY OFF-HOST (password manager / secret store).
#     If it is lost, every encrypted backup is unrecoverable.
#     Artifacts keep their original key, so old backups stay readable after a
#     rotation — see the runbook section "Rotating the backup passphrase".
BACKUP_ENCRYPTION_KEY_BASE64=

# ── Database ─────────────────────────────────────────────────────────────────
# Prefer a DEDICATED backup user with least privilege:
#   CREATE USER 'backup'@'localhost' IDENTIFIED BY '...';
#   GRANT SELECT, LOCK TABLES, SHOW VIEW, TRIGGER, PROCESS ON *.* TO 'backup'@'localhost';
# Do NOT use root.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u727965524_airesume
DB_USER=backup
DB_PASSWORD=

# ── Local backup location ────────────────────────────────────────────────────
# Must resolve OUTSIDE the web document root. The pipeline enforces this.
BACKUP_DIR=/home/u727965524/domains/projectdemo.guru/private/resumepilot/backups/scheduled

# Optional second local disk / mount. Leave empty to disable.
# Remember: a second directory on the SAME host is not an offsite copy.
BACKUP_SECONDARY_DIR=

# ── Offsite (independent) copy ───────────────────────────────────────────────
# THIS IS WHAT MAKES "LOSS OF THE HOST" RECOVERABLE.
# Without it you have 2 copies on 1 host and 0 offsite — 3-2-1 is NOT met.
#
# There is no "enable" flag: setting BACKUP_OFFSITE_DESTINATION configures it.
# Supported destinations, auto-detected from whichever CLI is installed:
#
#   rclone   BACKUP_OFFSITE_DESTINATION=myremote:resumepilot-backups
#            (also set BACKUP_OFFSITE_RCLONE_REMOTE=myremote)
#   aws      BACKUP_OFFSITE_DESTINATION=s3://my-bucket/resumepilot
#   gsutil   BACKUP_OFFSITE_DESTINATION=gs://my-bucket/resumepilot
#   az       BACKUP_OFFSITE_DESTINATION=https://myaccount.blob.core.windows.net/resumepilot
#
# Recommended bucket settings: private, versioning ON, object lock / immutability
# ON (the defence against ransomware deleting your backups), access logging ON.
BACKUP_OFFSITE_DESTINATION=
BACKUP_OFFSITE_RCLONE_REMOTE=
BACKUP_OFFSITE_RCLONE_PATH=

# When a destination is configured, an UNVERIFIED upload fails the run.
# A backup is only a success if an independent copy was confirmed to exist.
# Set to false only if you accept running with no verified offsite copy.
BACKUP_OFFSITE_REQUIRED=true

# Upload retry attempts with exponential backoff + jitter (1-10, default 3).
BACKUP_OFFSITE_MAX_ATTEMPTS=3

# ── Restore drill ───────────────────────────────────────────────────────────
# The drill restores into an ISOLATED scratch database, never production.
# Three independent guards must ALL be satisfied or it refuses to run.
#
#   DR_RESTORE_TARGET_DB      name must contain test|ci|cert|sandbox|scratch|
#                             restore|drill, and must not be a known production
#                             database (u727965524_airesume, airesume,
#                             ai_resume_builder, resumepilot by default;
#                             extend with DR_PRODUCTION_DATABASES).
#   DR_TARGET_HOST            must be loopback (127.0.0.1 / localhost / ::1).
#   MARIADB_TEST_ALLOW_RESET  explicit opt-in to destructive action.
#   DB_RESTORE_CONFIRM        must equal exactly "RESTORE:<target_db>".
DR_RESTORE_TARGET_DB=resumepilot_restore_drill
DR_TARGET_HOST=127.0.0.1
DR_TARGET_PORT=3306
DR_TARGET_USER=root
DR_TARGET_PASSWORD=
MARIADB_TEST_ALLOW_RESET=true
DB_RESTORE_CONFIRM=RESTORE:resumepilot_restore_drill

# Comma-separated tables that must exist and be non-empty after a restore.
DR_CRITICAL_TABLES=users,schema_migrations
# Tables that must contain at least one row.
DR_REQUIRE_ROWS_TABLES=users

# ── Monitoring ──────────────────────────────────────────────────────────────
# Optional webhook notified on failure. Keep it out of the logs.
BACKUP_ALERT_WEBHOOK_URL=
# Age at which backups are considered stale (hours).
DR_MAX_BACKUP_AGE_HOURS=26
